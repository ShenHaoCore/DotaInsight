<UserControl x:Class="DotaInsight.Views.Dialogs.NetworkSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DotaInsight.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkSettingsDialogViewModel}"
             d:DesignWidth="520">

    <Grid Margin="24,20,24,22" MinHeight="240">

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42"
                        CornerRadius="10"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DiAccentSoftBrush}">
                    <ui:SymbolIcon Symbol="Globe24"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiAccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="网络设置" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="到 OpenDota 的线路可能被间歇掐断，配置本地代理（如 Clash 的 7890 端口）后，所有 API 请求改走代理通道。保存后即时生效，无需重启。"
                               FontSize="12"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               LineHeight="17"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Grid>

            <!-- 代理地址 -->
            <TextBlock Text="代理地址（留空 = 直连）"
                       Style="{StaticResource DiKickerTextStyle}"
                       Margin="0,18,0,0" />
            <ui:TextBox Margin="0,6,0,0"
                        PlaceholderText="http://127.0.0.1:7890 或 socks5://127.0.0.1:7890"
                        Text="{Binding ProxyUrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 校验错误 -->
            <TextBlock Text="{Binding ValidationError}"
                       FontSize="12"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource DiDisadvantageBrush}"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- 连通性测试 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Secondary"
                           Content="测试连通"
                           MinWidth="96"
                           IsEnabled="{Binding CanSave}"
                           Command="{Binding TestCommand}" />
                <TextBlock Text="{Binding TestResultText}"
                           FontSize="12"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>

            <Border Margin="0,14,0,0"
                    Padding="12,9"
                    CornerRadius="4"
                    Background="{DynamicResource DiShardSoftBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiShardBrush}" />
                    <TextBlock Margin="8,0,0,0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DiMutedTextBrush}"
                               Text="代理地址对所有 API 请求生效（战绩 / 选手榜 / 英雄资料 / 更新检查）。已缓存的数据不受影响。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Appearance="Secondary"
                           Content="取消"
                           MinWidth="88"
                           Command="{Binding DismissCommand}" />
                <ui:Button Appearance="Primary"
                           Content="保存"
                           MinWidth="108"
                           Margin="10,0,0,0"
                           IsEnabled="{Binding CanSave}"
                           Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
