<Page x:Class="DotaInsight.Views.Pages.HeroCounterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      Title="克制分析"
      Background="Transparent">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="MatchupRowTemplate">
            <Border Style="{StaticResource MatchupRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="32" CornerRadius="3" ClipToBounds="True"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Margin="0,5,10,0" Style="{StaticResource AdvantageProgressStyle}"
                                     Value="{Binding WinRateDiff, Mode=OneWay, Converter={StaticResource AdvantageToProgressConverter}}"
                                     Foreground="{Binding IsCountering, Converter={StaticResource AdvantageBrushConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding WinRateDiffText}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                               Foreground="{Binding IsCountering, Converter={StaticResource AdvantageBrushConverter}}" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding WinRateText}" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="{Binding MatchesText}" FontSize="10" Opacity="0.5" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="MatchupListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2,4,8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,12,20,16">
        <!-- 未选英雄 -->
        <Border Style="{StaticResource DiPanelCardStyle}"
                Padding="28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MinWidth="520"
                Visibility="{Binding HasSelectedHero, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Rectangle Width="7" Height="7" Fill="{DynamicResource DiAccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="MATCHUP ANALYSIS" Style="{StaticResource DiKickerTextStyle}" />
                </StackPanel>
                <TextBlock Text="克制分析"
                           Style="{StaticResource DiPageTitleStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,10,0,18"
                           FontSize="13"
                           Foreground="{DynamicResource DiMutedTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <ui:AutoSuggestBox Width="360"
                                   HorizontalAlignment="Center"
                                   PlaceholderText="搜索英雄开始分析"
                                   OriginalItemsSource="{Binding AllHeroes}"
                                   Text="{Binding HeroSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   ClearButtonEnabled="True"
                                   SuggestionChosen="OnHeroSuggestionChosen">
                    <ui:AutoSuggestBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
                <ui:Button Content="打开英雄图鉴"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Padding="16,8"
                           Command="{Binding OpenGalleryCommand}" />
            </StackPanel>
        </Border>

        <!-- 已选英雄分析 -->
        <Grid Visibility="{Binding HasSelectedHero, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="280" />
                <RowDefinition Height="12" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource DiHeroBannerBrush}"
                    BorderBrush="{DynamicResource DiStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="128" Height="72" CornerRadius="3" ClipToBounds="True"
                            BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,16,0">
                        <Image Source="{Binding SelectedHero.IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=220}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedHero.DisplayName}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="12"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ui:Button Content="详情" Appearance="Secondary" Command="{Binding OpenDetailCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="换英雄" Appearance="Secondary" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="刷新" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                            <DockPanel>
                                <Rectangle Width="3" Height="18" Fill="{DynamicResource DiDisadvantageBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="不利对位" FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Text="对方克制你" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CounteredByList.Count}"
                                           FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DiDisadvantageBrush}" />
                            </DockPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding CounteredByList}"
                                 ItemTemplate="{StaticResource MatchupRowTemplate}"
                                 Style="{StaticResource MatchupListStyle}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                            <DockPanel>
                                <Rectangle Width="3" Height="18" Fill="{DynamicResource DiAdvantageBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="有利对位" FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Text="你克制对方" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountersList.Count}"
                                           FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DiAdvantageBrush}" />
                            </DockPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding CountersList}"
                                 ItemTemplate="{StaticResource MatchupRowTemplate}"
                                 Style="{StaticResource MatchupListStyle}" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource DiPanelCardStyle}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="对位优势分布" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" Margin="2,0,2,4" />
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                        LegendPosition="Hidden"
                                        Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Grid.Row="1" Text="暂无对位数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}"
                               Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
