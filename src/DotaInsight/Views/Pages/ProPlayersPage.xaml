<Page x:Class="DotaInsight.Views.Pages.ProPlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1300"
      Background="{DynamicResource DiCanvasBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IntEqualityConverter x:Key="IntEquality" />
        <converters:IntEqualsToVisibilityConverter x:Key="IntEqualsVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:CachedImageConverter x:Key="CachedImageConverter" />
    </Page.Resources>

    <Grid Margin="18,8,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题行 ===== -->
        <Grid Grid.Row="0" Margin="2,4,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="职业选手" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                <TextBlock Text="{Binding AggregatedText}" FontSize="12" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Transparent"
                       ToolTip="刷新榜单"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- ===== 页签 ===== -->
        <Border Grid.Row="1" Padding="2" HorizontalAlignment="Left"
                Background="{DynamicResource DiChromeBrush}" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="选手榜" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding TopTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=0, Mode=TwoWay}" />
                <RadioButton Content="战队榜" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding TopTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=1, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <!-- 加载态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="34" Height="34" IsIndeterminate="True"
                                 HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>

            <!-- 失败态 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="420"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </Border>

            <!-- ===== 选手榜 ===== -->
            <Grid Grid.Row="0"
                  Visibility="{Binding TopTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                        Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="排名" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="选手" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="2" Text="战队" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="3" Text="位置" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="4" Text="场次数" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="5" Text="胜率" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource DiMutedTextBrush}" />
                        </Grid>
                        <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource DiStrokeBrush}" Margin="2,0,2,4" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DiRowButtonStyle}"
                                                Command="{Binding DataContext.OpenPlayerCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="查看该选手的战绩分析">
                                            <Grid Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RankNumber}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            ClipToBounds="True" Margin="0,0,8,0"
                                                            Background="{DynamicResource DiChromeBrush}"
                                                            BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1">
                                                        <Image Source="{Binding AvatarUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=48}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TeamName}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding RoleText}" FontSize="12"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding GamesPlayed}" FontSize="13"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                <TextBlock Grid.Column="5" Text="{Binding WinRateText}" FontSize="13"
                                                           TextAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiGoldBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 战队榜 ===== -->
            <Grid Grid.Row="0"
                  Visibility="{Binding TopTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=1}">
                <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                        Visibility="{Binding HasTeams, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="排名" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="战队" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="2" Text="评分" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="3" Text="胜 / 负" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                            <TextBlock Grid.Column="4" Text="胜率" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource DiMutedTextBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource DiStrokeBrush}" Margin="2,0,2,4" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Teams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="40" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RankNumber}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Tag, StringFormat=· {0}}" FontSize="11" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiMutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding RatingText}" FontSize="13"
                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                            <TextBlock Grid.Column="3" FontSize="13" TextAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Wins, Mode=OneWay}" Foreground="{DynamicResource DiAdvantageBrush}" />
                                                <Run Text=" / " Foreground="{DynamicResource DiMutedTextBrush}" />
                                                <Run Text="{Binding Losses, Mode=OneWay}" Foreground="{DynamicResource DiDisadvantageBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding WinRateText}" FontSize="13"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DiGoldBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
