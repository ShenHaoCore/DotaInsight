<Page x:Class="DotaInsight.Views.Pages.MatchDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      Title="比赛详情"
      Background="Transparent">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:CachedImageConverter x:Key="CachedImageConverter" />

        <!-- 整行可点：外层 Button 只负责点击与手型光标，视觉交给内层行 Border -->
        <Style x:Key="DetailPlayerRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 装备格：空槽位保留方框，保证 6 格始终对齐 -->
        <DataTemplate x:Key="ItemSlotTemplate">
            <Border Width="26" Height="26" Margin="0,0,4,0"
                    CornerRadius="3"
                    Background="{DynamicResource DiChromeBrush}"
                    BorderBrush="{DynamicResource DiStrokeBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <!-- 单名玩家 -->
        <DataTemplate x:Key="PlayerRowTemplate">
            <Button Style="{StaticResource DetailPlayerRowButton}"
                    Command="{Binding DataContext.OpenPlayerCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="点击查看该玩家的战绩">
                <Border Style="{StaticResource MatchupRowBorderStyle}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 头像列：48 头像 + 8 间距，列宽必须与下方表头逐列一致 -->
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <!-- 装备列固定宽：6×(26+4) + 中立(2+26) = 208，与表头共享同一数值 -->
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>

                        <!-- 英雄头像：官方立绘是 256×144 横版且头部偏右，裁成正方形会切脸，
                             用 16:9 横版框（48×27）完整容纳，与战绩列表的头像比例一致 -->
                        <Border Grid.Column="0"
                                Width="48" Height="27"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="{DynamicResource DiChromeBrush}"
                                Margin="0,0,8,0">
                            <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=120}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- 玩家名 + 英雄名 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding HeroName}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- KDA -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KdaText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding KdaRatioText, StringFormat=KDA {0}}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding LevelText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />

                        <!-- GPM / XPM -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GoldPerMin, StringFormat=GPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiGoldBrush}" />
                            <TextBlock Text="{Binding XpPerMin, StringFormat=XPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 补刀 / 反补 -->
                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastHitsText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="补刀/反补"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 净经济 -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetWorthText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="净经济"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 英雄伤害 -->
                        <StackPanel Grid.Column="7" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroDamageText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="英雄伤害"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 装备栏：6 主物品 + 中立物品 -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ItemIconUrls}"
                                          ItemTemplate="{StaticResource ItemSlotTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Width="26" Height="26"
                                    CornerRadius="3"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource DiChromeBrush}"
                                    BorderBrush="{DynamicResource DiGoldBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    ToolTip="中立物品">
                                <Image Source="{Binding NeutralItemIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!-- 画布背景：与英雄详情页一致，页面自己刷底色（离屏渲染与应用内都成立） -->
    <Grid Background="{DynamicResource DiCanvasBrush}">
      <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Secondary"
                           Padding="10,4"
                           Command="{Binding GoBackCommand}"
                           ToolTip="返回战绩分析" />
                <Rectangle Width="3" Height="16" Fill="{DynamicResource DiAccentBrush}"
                           Margin="14,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="比赛详情" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                <TextBlock Text="{Binding MatchId, StringFormat=#{0}}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Detail.StartTimeText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource DiMutedTextBrush}" />
        </Grid>

        <!-- ===== 战况横幅 ===== -->
        <Border Grid.Row="1"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="20,16"
                Margin="0,0,0,12"
                Visibility="{Binding HasBasic, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="天辉" FontSize="12"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantResultText}"
                               FontSize="13" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.ScoreText}"
                               FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DurationText}"
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Detail.GameModeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="·" FontSize="11" Margin="6,0"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="{Binding Detail.LobbyTypeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="夜魇" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireResultText}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 阵容 ===== -->
        <Grid Grid.Row="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <!-- 列头：列宽与行模板逐列一致；外边距 24 = 卡片边框1 + 列表边距5 +
                         行边距5 + 行边框1 + 行内边距12，保证两套 Grid 左右边缘完全重合 -->
                    <Grid Margin="24,0,24,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="玩家 / 英雄" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="2" Text="K / D / A" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="3" Text="等级" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="4" Text="经济 / 经验" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="5" Text="补刀" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="6" Text="净经济" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="7" Text="伤害" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="8" Text="装备" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </Grid>

                    <!-- 天辉 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiAdvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                        <TextBlock Text="天辉" FontSize="11"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Radiant.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Radiant}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="5,6,5,6" />
                        </DockPanel>
                    </Border>

                    <!-- 夜魇 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiDisadvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                        <TextBlock Text="夜魇" FontSize="11"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Dire.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Dire}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="5,6,5,6" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="点击任意一名玩家可查看他的近期战绩。"
                               Margin="2,10,0,0" FontSize="11"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="34" Height="34" IsIndeterminate="True"
                                 HorizontalAlignment="Center" />
                <TextBlock Text="正在加载比赛详情…" Margin="0,14,0,0"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>

            <!-- 未解析 / 加载失败 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Rectangle Width="32" Height="3" Fill="{DynamicResource DiAccentBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="暂时拿不到逐人数据"
                               FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
      </Grid>
    </Grid>
</Page>
