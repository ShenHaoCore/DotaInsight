<Page x:Class="DotaInsight.Views.Pages.MatchDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      Title="比赛详情"
      Background="Transparent">
    <Page.Resources>
        <converters:IntEqualityConverter x:Key="IntEquality" />
        <converters:IntEqualsToVisibilityConverter x:Key="IntEqualsVisibility" />


        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:CachedImageConverter x:Key="CachedImageConverter" />


        <!-- 时间轴刻度按钮：透明壳，只留形状可点 -->
        <Style x:Key="MapTickButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 整行可点：外层 Button 只负责点击与手型光标，视觉交给内层行 Border -->
        <Style x:Key="DetailPlayerRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 装备格：空槽位保留方框，保证 6 格始终对齐 -->
        <DataTemplate x:Key="ItemSlotTemplate">
            <Border Width="26" Height="26" Margin="0,0,4,0"
                    CornerRadius="4"
                    Background="{DynamicResource DiChromeBrush}"
                    BorderBrush="{DynamicResource DiStrokeBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <!-- 单名玩家 -->
        <DataTemplate x:Key="PlayerRowTemplate">
            <Button Style="{StaticResource DetailPlayerRowButton}"
                    Command="{Binding DataContext.OpenPlayerCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="点击查看该玩家的战绩">
                <Border Style="{StaticResource MatchupRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 头像列：48 头像 + 8 间距，列宽必须与下方表头逐列一致 -->
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <!-- 装备列固定宽：6×(26+4) + 中立(2+26) = 208，与表头共享同一数值 -->
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>

                        <!-- 英雄头像：官方立绘是 256×144 横版且头部偏右，裁成正方形会切脸，
                             用 16:9 横版框（48×27）完整容纳，与战绩列表的头像比例一致 -->
                        <Border Grid.Column="0"
                                Width="48" Height="27"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="{DynamicResource DiChromeBrush}"
                                Margin="0,0,8,0">
                            <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=120}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- 玩家名 + 英雄名 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding HeroName}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- KDA -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KdaText}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding KdaRatioText, StringFormat=KDA {0}}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding LevelText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />

                        <!-- GPM / XPM -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GoldPerMin, StringFormat=GPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiGoldBrush}" />
                            <TextBlock Text="{Binding XpPerMin, StringFormat=XPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 补刀 / 反补 -->
                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastHitsText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="补刀/反补"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 净经济 -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetWorthText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="净经济"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 英雄伤害 -->
                        <StackPanel Grid.Column="7" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroDamageText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="英雄伤害"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 装备栏：6 主物品 + 中立物品 -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ItemIconUrls}"
                                          ItemTemplate="{StaticResource ItemSlotTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Width="26" Height="26"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource DiChromeBrush}"
                                    BorderBrush="{DynamicResource DiGoldBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    ToolTip="中立物品">
                                <Image Source="{Binding NeutralItemIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!-- 画布背景：与英雄详情页一致，页面自己刷底色（离屏渲染与应用内都成立） -->
    <Grid Background="{DynamicResource DiCanvasBrush}">
      <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 模式专属：技能征召 / BP 过程 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Secondary"
                           Padding="10,4"
                           Command="{Binding GoBackCommand}"
                           ToolTip="返回战绩分析" />
                <TextBlock Text="比赛详情" FontSize="15" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                <TextBlock Text="{Binding MatchId, StringFormat=#{0}}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Detail.StartTimeText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource DiMutedTextBrush}" />
        </Grid>

        <!-- ===== 战况横幅：本页的时刻——两队 + 大比分 ===== -->
        <Border Grid.Row="1"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="20,16"
                Margin="0,0,0,12"
                Visibility="{Binding HasBasic, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="天辉" FontSize="12"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                               FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantResultText}"
                               FontSize="13" FontWeight="Medium" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.ScoreText}"
                               FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DurationText}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Detail.GameModeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="·" FontSize="11" Margin="6,0"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="{Binding Detail.LobbyTypeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="夜魇" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                               FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireResultText}"
                               FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 模式专属卡片：技能征召 / BP 过程（其他模式此行无内容） ===== -->
        <Grid Grid.Row="2">
            <!-- 技能征召（OMG）：每名玩家选到的技能 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12" Margin="0,0,0,12"
                    Visibility="{Binding HasAbilityDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="技能征召" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="每名玩家从公共技能池中选用技能"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <TextBlock Text="天辉" FontSize="11" Margin="2,0,0,6"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding AbilityDraftRadiant}" Margin="2,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding DraftedAbilityIconUrls}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="30" Margin="0,0,4,4"
                                                        CornerRadius="4" ClipToBounds="True"
                                                        Background="{DynamicResource DiChromeBrush}"
                                                        BorderBrush="{DynamicResource DiStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="夜魇" FontSize="11" Margin="2,0,0,6"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding AbilityDraftDire}" Margin="2,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding DraftedAbilityIconUrls}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="30" Margin="0,0,4,4"
                                                        CornerRadius="4" ClipToBounds="True"
                                                        Background="{DynamicResource DiChromeBrush}"
                                                        BorderBrush="{DynamicResource DiStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 队长模式 / 队长征召：Ban/Pick 过程 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12" Margin="0,0,0,12"
                    Visibility="{Binding HasDraftSteps, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="BP 过程" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="按实际顺序展示 Ban 与 Pick"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Detail.DraftSteps}" Margin="2,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="46" Margin="0,0,6,6" ToolTip="{Binding Tooltip}">
                                    <Border Width="40" Height="23" CornerRadius="4" ClipToBounds="True"
                                            BorderThickness="1"
                                            Background="{DynamicResource DiChromeBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DiAdvantageBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DiDisadvantageBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPick}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=96}"
                                               Stretch="UniformToFill" HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- Ban = 灰化 + 叉标 -->
                                    <Border Width="40" Height="23" CornerRadius="4" ClipToBounds="True"
                                            Background="#660B0D11"
                                            Visibility="{Binding IsPick, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="13"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 页签：阵容 / 经济曲线 / 小地图 ===== -->
        <Border Grid.Row="3" Padding="2" HorizontalAlignment="Left"
                Background="{DynamicResource DiChromeBrush}" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="阵容" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=0, Mode=TwoWay}" />
                <!-- 数据缺失的页签直接隐藏（未解析的比赛只留「阵容」），原因由页面级公告卡说明 -->
                <RadioButton Content="经济曲线" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding AdvantageHasData, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=1, Mode=TwoWay}" />
                <RadioButton Content="输出承伤" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasDamageChart, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=2, Mode=TwoWay}" />
                <RadioButton Content="装备投入" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasItemTab, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=3, Mode=TwoWay}" />
                <RadioButton Content="补刀对比" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasLastHits, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=4, Mode=TwoWay}" />
                <RadioButton Content="成长曲线" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasGrowth, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=5, Mode=TwoWay}" />
                <RadioButton Content="对线期" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasLaning, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=6, Mode=TwoWay}" />
                <RadioButton Content="击杀矩阵" Style="{StaticResource DiSegmentedItem}"
                             Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=7, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- ===== 阵容（页签 0） ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=0}">

            <!-- 阵容内滚动上限：比分 + 页签 + 阵容尽量收进一屏，长阵容列表内滚动 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <!-- 列头：列宽与行模板逐列一致；外边距 25 = 卡片边框1 + 列表边距12 +
                         行内边距12（行无描边），保证两套 Grid 左右边缘完全重合 -->
                    <Grid Margin="25,0,25,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="玩家 / 英雄" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="2" Text="K / D / A" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="3" Text="等级" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="4" Text="经济 / 经验" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="5" Text="补刀" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="6" Text="净经济" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="7" Text="伤害" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="8" Text="装备" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </Grid>

                    <!-- 天辉 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Radiant.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiAdvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                                                   Style="{StaticResource DiSectionTitleStyle}" />
                                        <TextBlock Text="天辉" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Radiant}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="12,8" />
                        </DockPanel>
                    </Border>

                    <!-- 夜魇 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Dire.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiDisadvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                                                   Style="{StaticResource DiSectionTitleStyle}" />
                                        <TextBlock Text="夜魇" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Dire}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="12,8" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="点击任意一名玩家可查看他的近期战绩"
                               Margin="2,10,0,0" FontSize="11"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="34" Height="34" IsIndeterminate="True"
                                 HorizontalAlignment="Center" />
                <TextBlock Text="正在加载比赛详情…" Margin="0,14,0,0"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>

            <!-- 未解析 / 加载失败 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="暂时拿不到逐人数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 经济曲线（页签 1） ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=1}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding AdvantageHasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="大于 0 = 天辉领先 · 金色经济 · 蓝色经验"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="经济 / 经验优势曲线"
                                   Style="{StaticResource DiSectionTitleStyle}" />
                    </DockPanel>
                    <lvc:CartesianChart Grid.Row="1"
                                        Background="Transparent"
                                        Series="{Binding AdvantageSeries}"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding AdvantageHasData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="暂无优势曲线数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="比赛未被解析、加速模式或数据源缺失时没有逐分钟优势记录。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 输出承伤（页签 2）：双方全员英雄伤害对比 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=2}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasDamageChart, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="输出承伤" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding DamageSummaryText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <lvc:CartesianChart Height="430"
                                        Series="{Binding DamageSeries}"
                                        XAxes="{Binding DamageXAxes}"
                                        YAxes="{Binding DamageYAxes}"
                                        LegendPosition="Hidden" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasDamageChart, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无输出数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，逐人伤害统计暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 装备投入（页签 3）：双方全员购买总价 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=3}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasItemGold, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="装备投入" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ItemGoldSummary}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <lvc:CartesianChart Height="430"
                                        Series="{Binding ItemGoldSeries}"
                                        XAxes="{Binding ItemGoldXAxes}"
                                        YAxes="{Binding ItemGoldYAxes}"
                                        LegendPosition="Hidden" />

                    <!-- 装备购买时间线：每名玩家一行，图标按购买时刻定位（悬停看详情） -->
                    <TextBlock Text="装备购买时间线" FontSize="11" Margin="2,12,0,4"
                               Foreground="{DynamicResource DiMutedTextBrush}"
                               Visibility="{Binding HasPurchases, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding PurchaseRows}"
                                  Visibility="{Binding HasPurchases, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlayerLabel}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <Canvas Grid.Column="1" Width="740" Height="24" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="4" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Width="26" Height="17"
                                                           Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill"
                                                           ToolTip="{Binding Tooltip}"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasItemTab, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无装备投入数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，装备购买价格暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 补刀对比（页签 4）：双方全员按补刀数 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=4}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasLastHits, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="补刀对比" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding LastHitsSummary}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <lvc:CartesianChart Height="430"
                                        Series="{Binding LastHitsSeries}"
                                        XAxes="{Binding LastHitsXAxes}"
                                        YAxes="{Binding LastHitsYAxes}"
                                        LegendPosition="Hidden" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasLastHits, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无补刀数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，逐人补刀统计暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 成长曲线（页签 5）：选中玩家的金币/经验/正补逐分钟曲线 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=5}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasGrowth, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="英雄成长曲线" Style="{StaticResource DiSectionTitleStyle}" />
                            <TextBlock Text="金币/经验为累计值" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="选择玩家：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                            <ComboBox ItemsSource="{Binding GrowthPlayers}"
                                      SelectedItem="{Binding SelectedGrowthPlayer}"
                                      DisplayMemberPath="TeamLabel"
                                      Width="180" Margin="6,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <lvc:CartesianChart Height="230"
                                        Series="{Binding GrowthSeries}"
                                        XAxes="{Binding GrowthXAxes}"
                                        YAxes="{Binding GrowthYAxes}"
                                        LegendPosition="Top" />
                    <TextBlock Text="正补（累计）" FontSize="11" Margin="2,10,0,4"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <lvc:CartesianChart Height="170"
                                        Series="{Binding GrowthLhSeries}"
                                        XAxes="{Binding GrowthLhXAxes}"
                                        YAxes="{Binding GrowthLhYAxes}"
                                        LegendPosition="Hidden" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasGrowth, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无成长曲线数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，逐分钟统计暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 对线期（页签 6）：10 分钟基准（正补/反补/金币） ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=6}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasLaning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="对线期分析" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="10 分钟基准"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <!-- 分路对线评价：lane_role 为玩家自身视角，交叉配对后的天辉 vs 夜魇胜负 -->
                    <ItemsControl ItemsSource="{Binding LaneVerdicts}" Margin="2,0,2,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="258" Margin="0,0,10,0" Padding="12,9"
                                        Background="{DynamicResource DiPanelElevatedBrush}"
                                        BorderBrush="{DynamicResource DiStrokeBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource DiCornerLg}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding LaneLabel}" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" FontSize="11"
                                                       FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RadiantLeads}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTie}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding SideAStats}" FontSize="11" FontFamily="Consolas">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SideAIsRadiant}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="  vs  " FontSize="11"
                                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                                            <TextBlock Text="{Binding SideBStats}" FontSize="11" FontFamily="Consolas">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SideAIsRadiant}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="2,0,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="玩家" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="分路" FontSize="11" Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="2" Text="正补@10" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="3" Text="反补@10" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="4" Text="金币@10" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource DiMutedTextBrush}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource DiStrokeBrush}" Margin="2,0,2,4" />
                    <ItemsControl ItemsSource="{Binding LaningRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PlayerLabel}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LaneName}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Lh10}" FontSize="12" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Denies10}" FontSize="12" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Gold10, StringFormat={}{0:N0}}" FontSize="12" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasLaning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无对线期数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，10 分钟基准数据暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 击杀矩阵（页签 7）：击杀者 × 受害者 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=7}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="击杀矩阵" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="行=击杀者 列=受害者"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="击杀者 ＼ 被击杀" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding MatrixVictimHeader}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Width="46" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MatrixRows}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding KillerLabel}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 热度底按击杀者阵营着色，透明度随击杀数递增；文字始终全亮 -->
                                                <Grid Width="46" Height="24" Margin="0,0,0,0">
                                                    <Border CornerRadius="3" Margin="1"
                                                            Opacity="{Binding Heat}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource DiAdvantageBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource DiDisadvantageBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无击杀数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析，击杀记录暂时缺失。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
