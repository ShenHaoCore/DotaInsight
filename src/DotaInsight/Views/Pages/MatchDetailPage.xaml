<Page x:Class="DotaInsight.Views.Pages.MatchDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      Title="比赛详情"
      Background="Transparent">
    <Page.Resources>
        <converters:IntEqualityConverter x:Key="IntEquality" />
        <converters:IntEqualsToVisibilityConverter x:Key="IntEqualsVisibility" />

        <!-- 眼位：填充按类型（观察=金 / 岗哨=蓝），描边按阵营（天辉=绿 / 夜魇=红） -->
        <Style x:Key="WardDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource DiGoldBrush}" />
            <Setter Property="Stroke" Value="#2DA44E" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsObserver}" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource DiShardBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                    <Setter Property="Stroke" Value="#F0564A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:CachedImageConverter x:Key="CachedImageConverter" />

        <!-- 小地图图层开关：checked = 抬表面 + 主文字色，不用红（红留给选中页签） -->
        <Style x:Key="MapLayerChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DiStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时间轴刻度按钮：透明壳，只留形状可点 -->
        <Style x:Key="MapTickButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 整行可点：外层 Button 只负责点击与手型光标，视觉交给内层行 Border -->
        <Style x:Key="DetailPlayerRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 装备格：空槽位保留方框，保证 6 格始终对齐 -->
        <DataTemplate x:Key="ItemSlotTemplate">
            <Border Width="26" Height="26" Margin="0,0,4,0"
                    CornerRadius="4"
                    Background="{DynamicResource DiChromeBrush}"
                    BorderBrush="{DynamicResource DiStrokeBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <!-- 单名玩家 -->
        <DataTemplate x:Key="PlayerRowTemplate">
            <Button Style="{StaticResource DetailPlayerRowButton}"
                    Command="{Binding DataContext.OpenPlayerCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="点击查看该玩家的战绩">
                <Border Style="{StaticResource MatchupRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 头像列：48 头像 + 8 间距，列宽必须与下方表头逐列一致 -->
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <!-- 装备列固定宽：6×(26+4) + 中立(2+26) = 208，与表头共享同一数值 -->
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>

                        <!-- 英雄头像：官方立绘是 256×144 横版且头部偏右，裁成正方形会切脸，
                             用 16:9 横版框（48×27）完整容纳，与战绩列表的头像比例一致 -->
                        <Border Grid.Column="0"
                                Width="48" Height="27"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="{DynamicResource DiChromeBrush}"
                                Margin="0,0,8,0">
                            <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=120}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- 玩家名 + 英雄名 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding HeroName}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- KDA -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KdaText}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding KdaRatioText, StringFormat=KDA {0}}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding LevelText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />

                        <!-- GPM / XPM -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GoldPerMin, StringFormat=GPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiGoldBrush}" />
                            <TextBlock Text="{Binding XpPerMin, StringFormat=XPM {0}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 补刀 / 反补 -->
                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastHitsText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="补刀/反补"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 净经济 -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetWorthText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="净经济"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 英雄伤害 -->
                        <StackPanel Grid.Column="7" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroDamageText}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="英雄伤害"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>

                        <!-- 装备栏：6 主物品 + 中立物品 -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ItemIconUrls}"
                                          ItemTemplate="{StaticResource ItemSlotTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Width="26" Height="26"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource DiChromeBrush}"
                                    BorderBrush="{DynamicResource DiGoldBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    ToolTip="中立物品">
                                <Image Source="{Binding NeutralItemIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!-- 画布背景：与英雄详情页一致，页面自己刷底色（离屏渲染与应用内都成立） -->
    <Grid Background="{DynamicResource DiCanvasBrush}">
      <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 模式专属：技能征召 / BP 过程 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Secondary"
                           Padding="10,4"
                           Command="{Binding GoBackCommand}"
                           ToolTip="返回战绩分析" />
                <TextBlock Text="比赛详情" FontSize="15" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                <TextBlock Text="{Binding MatchId, StringFormat=#{0}}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Detail.StartTimeText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource DiMutedTextBrush}" />
        </Grid>

        <!-- ===== 战况横幅：本页的时刻——两队 + 大比分 ===== -->
        <Border Grid.Row="1"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="20,16"
                Margin="0,0,0,12"
                Visibility="{Binding HasBasic, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="天辉" FontSize="12"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                               FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.RadiantResultText}"
                               FontSize="13" FontWeight="Medium" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.ScoreText}"
                               FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DurationText}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Detail.GameModeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="·" FontSize="11" Margin="6,0"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="{Binding Detail.LobbyTypeText}" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="夜魇" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                               FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail.DireResultText}"
                               FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.RadiantWin}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 模式专属卡片：技能征召 / BP 过程（其他模式此行无内容） ===== -->
        <Grid Grid.Row="2">
            <!-- 技能征召（OMG）：每名玩家选到的技能 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12" Margin="0,0,0,12"
                    Visibility="{Binding HasAbilityDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="技能征召" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="每名玩家从公共技能池中选用技能"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <TextBlock Text="天辉" FontSize="11" Margin="2,0,0,6"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding AbilityDraftRadiant}" Margin="2,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding DraftedAbilityIconUrls}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="30" Margin="0,0,4,4"
                                                        CornerRadius="4" ClipToBounds="True"
                                                        Background="{DynamicResource DiChromeBrush}"
                                                        BorderBrush="{DynamicResource DiStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="夜魇" FontSize="11" Margin="2,0,0,6"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding AbilityDraftDire}" Margin="2,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding DraftedAbilityIconUrls}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="30" Margin="0,0,4,4"
                                                        CornerRadius="4" ClipToBounds="True"
                                                        Background="{DynamicResource DiChromeBrush}"
                                                        BorderBrush="{DynamicResource DiStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Converter={StaticResource CachedImageConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 队长模式 / 队长征召：Ban/Pick 过程 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12" Margin="0,0,0,12"
                    Visibility="{Binding HasDraftSteps, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="BP 过程" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="按实际顺序展示 Ban 与 Pick"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Detail.DraftSteps}" Margin="2,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="46" Margin="0,0,6,6" ToolTip="{Binding Tooltip}">
                                    <Border Width="40" Height="23" CornerRadius="4" ClipToBounds="True"
                                            BorderThickness="1"
                                            Background="{DynamicResource DiChromeBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DiAdvantageBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DiDisadvantageBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPick}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=96}"
                                               Stretch="UniformToFill" HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- Ban = 灰化 + 叉标 -->
                                    <Border Width="40" Height="23" CornerRadius="4" ClipToBounds="True"
                                            Background="#660B0D11"
                                            Visibility="{Binding IsPick, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="13"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 页签：阵容 / 经济曲线 / 小地图 ===== -->
        <Border Grid.Row="3" Padding="2" HorizontalAlignment="Left"
                Background="{DynamicResource DiChromeBrush}" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="阵容" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=0, Mode=TwoWay}" />
                <RadioButton Content="经济曲线" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=1, Mode=TwoWay}" />
                <RadioButton Content="小地图" Style="{StaticResource DiSegmentedItem}"
                             IsChecked="{Binding BottomTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=2, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- ===== 阵容（页签 0） ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=0}">

            <!-- 阵容内滚动上限：比分 + 页签 + 阵容尽量收进一屏，长阵容列表内滚动 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <!-- 列头：列宽与行模板逐列一致；外边距 25 = 卡片边框1 + 列表边距12 +
                         行内边距12（行无描边），保证两套 Grid 左右边缘完全重合 -->
                    <Grid Margin="25,0,25,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="玩家 / 英雄" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="2" Text="K / D / A" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="3" Text="等级" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="4" Text="经济 / 经验" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="5" Text="补刀" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="6" Text="净经济" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="7" Text="伤害" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Grid.Column="8" Text="装备" FontSize="11"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </Grid>

                    <!-- 天辉 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Radiant.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiAdvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.RadiantTeamDisplay}"
                                                   Style="{StaticResource DiSectionTitleStyle}" />
                                        <TextBlock Text="天辉" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Radiant}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="12,8" />
                        </DockPanel>
                    </Border>

                    <!-- 夜魇 -->
                    <Border Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Dire.Count, StringFormat={}{0} 人}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource DiDisadvantageBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.DireTeamDisplay}"
                                                   Style="{StaticResource DiSectionTitleStyle}" />
                                        <TextBlock Text="夜魇" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Dire}"
                                          ItemTemplate="{StaticResource PlayerRowTemplate}"
                                          Margin="12,8" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="点击任意一名玩家可查看他的近期战绩"
                               Margin="2,10,0,0" FontSize="11"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="34" Height="34" IsIndeterminate="True"
                                 HorizontalAlignment="Center" />
                <TextBlock Text="正在加载比赛详情…" Margin="0,14,0,0"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </StackPanel>

            <!-- 未解析 / 加载失败 -->
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="暂时拿不到逐人数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 经济曲线（页签 1） ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=1}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding AdvantageHasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="大于 0 = 天辉领先 · 金色经济 · 蓝色经验"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <TextBlock Text="经济 / 经验优势曲线"
                                   Style="{StaticResource DiSectionTitleStyle}" />
                    </DockPanel>
                    <lvc:CartesianChart Grid.Row="1"
                                        Background="Transparent"
                                        Series="{Binding AdvantageSeries}"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding AdvantageHasData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="暂无优势曲线数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="比赛未被解析、加速模式或数据源缺失时没有逐分钟优势记录。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 战况小地图（页签 2）：眼位 / 建筑 / 热区 / 事件时间轴 ===== -->
        <Grid Grid.Row="5"
              Visibility="{Binding BottomTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=2}">
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="16,12"
                    Visibility="{Binding HasMapData, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="战况小地图" Style="{StaticResource DiSectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding VisibleWardCount, StringFormat=当前时刻 {0} 个眼位}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <ToggleButton Content="眼位" Style="{StaticResource MapLayerChip}"
                                          IsChecked="{Binding ShowWards, Mode=TwoWay}" />
                            <ToggleButton Content="建筑" Style="{StaticResource MapLayerChip}"
                                          IsChecked="{Binding ShowBuildings, Mode=TwoWay}" />
                            <ToggleButton Content="位置" Style="{StaticResource MapLayerChip}"
                                          IsChecked="{Binding ShowHeatmap, Mode=TwoWay}"
                                          Visibility="{Binding HasHeatmap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ToggleButton Content="英雄" Style="{StaticResource MapLayerChip}"
                                          IsChecked="{Binding ShowHeroes, Mode=TwoWay}"
                                          Visibility="{Binding HasHeroSpots, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid Width="420" Height="420"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ClipToBounds="True">
                            <Image Source="pack://application:,,,/DotaInsight;component/Assets/Map/minimap.jpg"
                                   Stretch="Fill" />
                            <!-- 位置分布：lane_pos 聚合位图（稀疏指纹，每人 2-10 格），线性上采样成柔点 -->
                            <Image Source="{Binding HeatmapImage}"
                                   Width="420" Height="420"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="Linear"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ShowHeatmap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!-- 英雄常驻位置：lane_pos 最高频格，整场静态 -->
                            <ItemsControl ItemsSource="{Binding HeroSpots}"
                                          Visibility="{Binding ShowHeroes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="16"
                                                CornerRadius="3"
                                                ClipToBounds="True"
                                                Background="#E60D1117"
                                                ToolTip="{Binding Tooltip}">
                                            <Image Source="{Binding HeroIconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=96}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 建筑层：按当前时刻立起/倒塌 -->
                            <ItemsControl ItemsSource="{Binding Buildings}"
                                          Visibility="{Binding ShowBuildings, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Size}"
                                                Height="{Binding Size}"
                                                CornerRadius="{Binding CornerRadius}"
                                                BorderThickness="1"
                                                ToolTip="{Binding Tooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource DiAdvantageBrush}" />
                                                    <Setter Property="BorderBrush" Value="#CC0B0D11" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource DiDisadvantageBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStanding}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource DiRowHoverBrush}" />
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 眼位层 -->
                            <ItemsControl ItemsSource="{Binding Wards}"
                                          Visibility="{Binding ShowWards, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!-- Canvas 面板读取的是容器（ContentPresenter）的附加属性，
                                     绑定必须挂在 ItemContainerStyle 上而非模板根元素 -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Style="{StaticResource WardDotStyle}"
                                                 ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- 事件时间轴：事件带（塔/兵营/肉山/一血）+ 击杀细带 + 拖动条 -->
                    <StackPanel Width="420" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Canvas Width="420" Height="18"
                                Visibility="{Binding HasEventTicks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding EventTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MapTickButton}"
                                                Command="{Binding DataContext.JumpToTimeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Label}">
                                            <Border Width="5" Height="17" CornerRadius="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DiAdvantageBrush}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource DiDisadvantageBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Roshan">
                                                                <Setter Property="Background" Value="{DynamicResource DiGoldBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Aegis">
                                                                <Setter Property="Background" Value="{DynamicResource DiGoldBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="FirstBlood">
                                                                <Setter Property="Background" Value="{DynamicResource DiPrimaryTextBrush}" />
                                                            </DataTrigger>
                                                            <!-- 团战：白描边空心条，与实心的胜负刻度区分 -->
                                                            <DataTrigger Binding="{Binding Kind}" Value="TeamFight">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DiPrimaryTextBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>

                        <Canvas Width="420" Height="8" Margin="0,2,0,0"
                                Visibility="{Binding HasKillTicks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding KillTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MapTickButton}"
                                                Command="{Binding DataContext.JumpToTimeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Label}"
                                                Opacity="0.55">
                                            <Border Width="2" Height="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DiAdvantageBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadiant}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource DiDisadvantageBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>

                        <Slider Minimum="-90"
                                Maximum="{Binding Detail.DurationSeconds}"
                                Value="{Binding CurrentTime}"
                                IsMoveToPointEnabled="True"
                                AutoToolTipPlacement="None"
                                ToolTip="拖动回放战况；最左为全部时间" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding CurrentTimeText}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                            <TextBlock Text="{Binding MapSummaryText}"
                                       FontSize="11" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="图例：金点=观察守卫 · 蓝点=岗哨守卫 · 描边绿=天辉 红=夜魇 · 建筑绿/红=立起 灰=已倒 · 刻度：实心=推塔 金=肉山 白=一血 空心=团战，点按跳转"
                               Margin="2,8,0,0" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DiPanelCardStyle}" Padding="32"
                    Visibility="{Binding HasMapData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="该比赛暂无小地图数据"
                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="这局尚未被 OpenDota 解析（通常在对局后数分钟至数日内完成），解析完成后重新打开即可查看。"
                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
      </Grid>
    </Grid>
</Page>
