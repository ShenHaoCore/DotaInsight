<Page x:Class="DotaInsight.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      xmlns:models="clr-namespace:DotaInsight.Models"
      Title="首页"
      Background="Transparent"
      Loaded="OnPageLoaded">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IndexPlusOneConverter x:Key="IndexPlusOneConverter" />

        <!-- 功能入口卡：利落角 + 幽灵序号 -->
        <Style x:Key="HomeFeatureButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource DiPanelBrush}"
                                BorderBrush="{DynamicResource DiStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="20,18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DiAccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 排行榜单行：排名 / 头像 / 名称 / 数值 -->
        <DataTemplate x:Key="MetaRankRowWin" DataType="{x:Type models:HeroStat}">
            <Border Style="{StaticResource MatchupRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource DiRankNumberStyle}"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                              Path=(ItemsControl.AlternationIndex),
                                              Converter={StaticResource IndexPlusOneConverter}}" />
                    <Border Grid.Column="1" Width="56" Height="32" CornerRadius="3" ClipToBounds="True"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding WinRateText}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiAdvantageBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MetaRankRowPick" DataType="{x:Type models:HeroStat}">
            <Border Style="{StaticResource MatchupRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource DiRankNumberStyle}"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                              Path=(ItemsControl.AlternationIndex),
                                              Converter={StaticResource IndexPlusOneConverter}}" />
                    <Border Grid.Column="1" Width="56" Height="32" CornerRadius="3" ClipToBounds="True"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding PickRateText}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiAccentBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,22,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" MinHeight="240" />
        </Grid.RowDefinitions>

        <!-- 顶部品牌横幅 -->
        <Border Grid.Row="0"
                Background="{DynamicResource DiHeroBannerBrush}"
                BorderBrush="{DynamicResource DiStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="26,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="400" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌 -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Width="7" Height="7" Fill="{DynamicResource DiAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="DOTA2 数据终端"
                                       Style="{StaticResource DiKickerTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="DotaInsight"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="英雄克制 · 战绩复盘 · 版本数据"
                                   Margin="0,7,0,0" FontSize="13"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>

                    <!-- 玩家查询 -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource DiPanelElevatedBrush}"
                            BorderBrush="{DynamicResource DiStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14,12"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="查询玩家战绩"
                                       FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right"
                                           Content="查询"
                                           Appearance="Primary"
                                           Margin="10,0,0,0"
                                           Padding="16,8"
                                           Command="{Binding SearchPlayerCommand}" />
                                <ui:TextBox PlaceholderText="Account ID / SteamID64"
                                            FontSize="13"
                                            Text="{Binding AccountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="OnAccountKeyDown" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 底栏状态 -->
                <DockPanel Grid.Row="1" Margin="0,16,0,0">
                    <Border DockPanel.Dock="Left" Height="1"
                            Background="{DynamicResource DiStrokeBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Width="28" />
                    <TextBlock Text="{Binding MetaStatus}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiMutedTextBrush}" />

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <!-- 检查更新（复用外壳命令）+ 当前版本号 -->
                        <ui:Button Appearance="Secondary"
                                   ToolTip="检查更新"
                                   Content="检查更新"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   FontSize="12"
                                   Padding="10,4"
                                   Command="{Binding CheckUpdateCommand}" />
                        <TextBlock Text="{Binding VersionText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <Rectangle Width="1" Height="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"
                                   Fill="{DynamicResource DiStrokeBrush}" />
                        <TextBlock Text="{Binding CacheInfoText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" />
                        <ui:Button Appearance="Transparent"
                                   ToolTip="清理本地缓存"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding ClearCacheCommand}"
                                   Margin="6,0,0,0"
                                   Padding="8" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 功能入口 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource HomeFeatureButtonStyle}"
                    MinHeight="118" Command="{Binding OpenGalleryCommand}">
                <Grid>
                    <TextBlock Text="01" FontSize="26" FontWeight="Bold"
                               Foreground="#1AF4F7FA"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="22"
                                       Foreground="{DynamicResource DiAccentBrush}"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="英雄图鉴" Margin="0,12,0,5" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="浏览全部英雄与基础数据"
                                   FontSize="12"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource HomeFeatureButtonStyle}"
                    MinHeight="118" Command="{Binding OpenCounterCommand}">
                <Grid>
                    <TextBlock Text="02" FontSize="26" FontWeight="Bold"
                               Foreground="#1AF4F7FA"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <ui:SymbolIcon Symbol="DualScreenVerticalScroll24" FontSize="22"
                                       Foreground="{DynamicResource DiAccentBrush}"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="克制分析" Margin="0,12,0,5" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="查看英雄对位优劣与胜率差"
                                   FontSize="12"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource HomeFeatureButtonStyle}"
                    MinHeight="118" Command="{Binding OpenMatchAnalysisCommand}">
                <Grid>
                    <TextBlock Text="03" FontSize="26" FontWeight="Bold"
                               Foreground="#1AF4F7FA"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Bottom">
                        <ui:SymbolIcon Symbol="DataHistogram24" FontSize="22"
                                       Foreground="{DynamicResource DiAccentBrush}"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="战绩分析" Margin="0,12,0,5" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock Text="复盘玩家近期比赛表现"
                                   FontSize="12"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- Meta 排行榜 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="16" Fill="{DynamicResource DiAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="高胜率英雄" Style="{StaticResource DiSectionTitleStyle}" />
                            </StackPanel>
                            <ui:ProgressRing DockPanel.Dock="Right" Width="18" Height="18"
                                             IsIndeterminate="True" Margin="8,0,0,0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Transparent"
                                       Content="查看图鉴"
                                       FontSize="12"
                                       Command="{Binding OpenGalleryCommand}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopWinRateHeroes}"
                                      AlternationCount="20"
                                      ItemTemplate="{StaticResource MetaRankRowWin}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="16" Fill="{DynamicResource DiAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="高选取英雄" Style="{StaticResource DiSectionTitleStyle}" />
                            </StackPanel>
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Transparent"
                                       Content="查看图鉴"
                                       FontSize="12"
                                       Command="{Binding OpenGalleryCommand}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopPickRateHeroes}"
                                      AlternationCount="20"
                                      ItemTemplate="{StaticResource MetaRankRowPick}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
