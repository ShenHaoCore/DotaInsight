<Page x:Class="DotaInsight.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      xmlns:models="clr-namespace:DotaInsight.Models"
      Title="首页"
      Background="Transparent"
      Loaded="OnPageLoaded">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IndexPlusOneConverter x:Key="IndexPlusOneConverter" />
        <converters:BracketSparklineConverter x:Key="BracketSparkline" />
        <LinearGradientBrush x:Key="SparkWinFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#592FD57F" Offset="0" />
            <GradientStop Color="#0D2FD57F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SparkPickFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#594FC3F7" Offset="0" />
            <GradientStop Color="#0D4FC3F7" Offset="1" />
        </LinearGradientBrush>

        <!-- 功能入口：横向一行，图标 + 名称 + 说明 + 箭头，悬停抬表面 -->
        <Style x:Key="HomeFeatureButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource DiPanelBrush}"
                                BorderBrush="{DynamicResource DiStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 排行榜单行：排名 / 头像 / 名称 / 数值 -->
        <DataTemplate x:Key="MetaRankRowWin" DataType="{x:Type models:HeroStat}">
            <Border Style="{StaticResource MatchupRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource DiRankNumberStyle}"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                              Path=(ItemsControl.AlternationIndex),
                                              Converter={StaticResource IndexPlusOneConverter}}" />
                    <Border Grid.Column="1" Width="56" Height="32" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <Grid Grid.Column="3" Width="76" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                          ToolTip="{Binding BracketWinTooltip}">
                        <Path Data="{Binding BracketWinRates, Converter={StaticResource BracketSparkline}, ConverterParameter=fill}"
                              Fill="{StaticResource SparkWinFill}" />
                        <Path Data="{Binding BracketWinRates, Converter={StaticResource BracketSparkline}}"
                              Stroke="{DynamicResource DiAdvantageBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{Binding BracketWinRates, Converter={StaticResource BracketSparkline}, ConverterParameter=dot}"
                              Fill="{DynamicResource DiAdvantageBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="4" Text="{Binding WinRateText}" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiAdvantageBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MetaRankRowPick" DataType="{x:Type models:HeroStat}">
            <Border Style="{StaticResource MatchupRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource DiRankNumberStyle}"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                              Path=(ItemsControl.AlternationIndex),
                                              Converter={StaticResource IndexPlusOneConverter}}" />
                    <Border Grid.Column="1" Width="56" Height="32" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <Grid Grid.Column="3" Width="76" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                          ToolTip="{Binding BracketPickTooltip}">
                        <Path Data="{Binding BracketPickShares, Converter={StaticResource BracketSparkline}, ConverterParameter=fill}"
                              Fill="{StaticResource SparkPickFill}" />
                        <Path Data="{Binding BracketPickShares, Converter={StaticResource BracketSparkline}}"
                              Stroke="{DynamicResource DiShardBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{Binding BracketPickShares, Converter={StaticResource BracketSparkline}, ConverterParameter=dot}"
                              Fill="{DynamicResource DiShardBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="4" Text="{Binding PickRateText}" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="240" />
        </Grid.RowDefinitions>

        <!-- 顶部：查询台（本页主操作） -->
        <Border Grid.Row="0"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="查询玩家战绩" Style="{StaticResource DiPageTitleStyle}" />
                    <TextBlock Text="输入 Account ID 或 SteamID64，复盘对局、常用英雄与对位克制"
                               Margin="0,6,0,0" FontSize="13"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,14,0,0">
                    <ui:Button DockPanel.Dock="Right"
                               Content="查询"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Search24}"
                               Margin="10,0,0,0"
                               Padding="20,9"
                               Command="{Binding SearchPlayerCommand}" />
                    <ui:TextBox FontSize="14"
                                Padding="12,8"
                                PlaceholderText="Account ID / SteamID64"
                                Text="{Binding AccountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="OnAccountKeyDown" />
                </DockPanel>

                <!-- 底栏状态 -->
                <DockPanel Grid.Row="2" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="{Binding VersionText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                        <Rectangle Width="1" Height="12"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Fill="{DynamicResource DiStrokeBrush}" />
                        <TextBlock Text="{Binding CacheInfoText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380" />
                    </StackPanel>

                    <TextBlock Text="{Binding MetaStatus}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Meta 排行榜 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <DockPanel>
                            <ui:ProgressRing DockPanel.Dock="Right" Width="18" Height="18"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="高胜率英雄" Style="{StaticResource DiSectionTitleStyle}" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TopWinRateHeroes}"
                                          AlternationCount="20"
                                          Margin="12,8,12,4"
                                          ItemTemplate="{StaticResource MetaRankRowWin}" />
                        </ScrollViewer>

                        <!-- 加载占位：覆盖在列表上层，数据到位即隐藏 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding MetaLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" />
                            <TextBlock Text="正在加载版本数据…" FontSize="12" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DiPanelCardStyle}" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="高选取英雄" Style="{StaticResource DiSectionTitleStyle}" />
                    </Border>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TopPickRateHeroes}"
                                          AlternationCount="20"
                                          Margin="12,8,12,4"
                                          ItemTemplate="{StaticResource MetaRankRowPick}" />
                        </ScrollViewer>

                        <!-- 加载占位：覆盖在列表上层，数据到位即隐藏 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding MetaLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" />
                            <TextBlock Text="正在加载版本数据…" FontSize="12" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
