<Page x:Class="DotaInsight.Views.Pages.HeroDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:helpers="clr-namespace:DotaInsight.Helpers"
      xmlns:conv="clr-namespace:DotaInsight.Converters"
      xmlns:models="clr-namespace:DotaInsight.Models"
      Title="英雄详情"
      Background="Transparent">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullVisibility" />
        <conv:IntEqualityConverter x:Key="IntEquality" />
        <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsVisibility" />
        <conv:AbilitySelectedConverter x:Key="AbilitySelected" />
        <conv:CachedImageConverter x:Key="CachedImage" />
        <conv:AttrBrushConverter x:Key="AttrBrush" />
        <conv:AdvantageToProgressConverter x:Key="AdvantageToProgress" />
        <conv:AdvantageBrushConverter x:Key="AdvantageBrush" />

        <StreamGeometry x:Key="DiMeleeSword">M 26.90,2.00 C 25.70,2.00 22.00,4.70 18.60,8.00 C 14.30,12.10 11.50,14.00 9.80,14.00 C 8.40,14.00 6.70,14.60 6.10,15.40 C 5.40,16.20 5.20,17.90 5.50,19.20 C 5.90,20.80 5.40,22.30 4.10,23.90 C 2.90,25.20 2.00,26.90 2.00,27.60 C 2.00,28.30 3.00,29.60 4.20,30.40 C 6.20,31.80 6.60,31.80 8.90,30.30 C 10.40,29.40 13.10,28.40 15.00,28.10 C 17.90,27.60 18.70,26.90 19.50,24.10 C 20.10,22.20 23.10,17.80 26.30,14.30 C 29.40,10.80 32.00,7.60 32.00,7.20 C 32.00,6.80 31.30,5.40 30.40,4.20 C 29.60,3.00 28.00,2.00 26.90,2.00 Z</StreamGeometry>

        <!-- ============ 技能图标按钮 ============ -->
        <Style x:Key="DiAbilityTile" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="58" Height="58"
                                CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource DiStrokeBrush}"
                                Background="{DynamicResource DiChromeBrush}">
                            <Image x:Name="Im"
                                   Source="{Binding IconUrl, Converter={StaticResource CachedImage}, ConverterParameter=128}"
                                   Margin="6" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AbilitySelected}">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedAbility"
                                                 RelativeSource="{RelativeSource AncestorType=Page}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DiAccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 图标 + 数值 的小标签（属性栏用） ============ -->
        <Style x:Key="DiMiniValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ 战斗属性小图标：字形是白色矢量，用 OpacityMask 染成主题文字色，
              否则在浅色卡片上会隐形 ============ -->
        <!-- 战斗属性小图标：直接显示官网原版 PNG（自带灰度层次，勿再套 OpacityMask 染色） -->
        <Style x:Key="DiGlyphIcon" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ 卡片内区块标题（红条 + 文字） ============ -->
        <Style x:Key="DiCardTitleRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- ============ 对位行：整行可点，跳到该英雄的克制分析 ============ -->
        <DataTemplate x:Key="MatchupRow" DataType="{x:Type models:HeroCounterItem}">
            <Button Cursor="Hand"
                    ToolTip="查看该英雄的克制分析"
                    Command="{Binding DataContext.OpenCounterForHeroCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Style="{StaticResource MatchupRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="32" CornerRadius="4" ClipToBounds="True"
                                        Background="{DynamicResource DiChromeBrush}" Margin="0,0,10,0">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource CachedImage}, ConverterParameter=140}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeroName}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Margin="0,5,10,0" Style="{StaticResource AdvantageProgressStyle}"
                                                 Value="{Binding WinRateDiff, Mode=OneWay, Converter={StaticResource AdvantageToProgress}}"
                                                 Foreground="{Binding IsCountering, Converter={StaticResource AdvantageBrush}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding WinRateDiffText}" FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                           Foreground="{Binding IsCountering, Converter={StaticResource AdvantageBrush}}" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding WinRateText}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                    <TextBlock Text="{Binding MatchesText}" FontSize="10" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!-- 禁用 Frame 模板自带的外层 ScrollViewer：否则小窗口时外层给内容无限高度，
         内部 * 行会被撑成内容高度，导致页签内滚动失效、整页被外层拖动。
         滚动只允许发生在下方显式声明的 ScrollViewer 上。 -->
    <Grid Background="{DynamicResource DiCanvasBrush}"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ 工具栏（固定，不随内容滚动） ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="英雄详情" Style="{StaticResource DiPageTitleStyle}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="12,0,0,0" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
                    <ui:Button Content="返回图鉴" Icon="{ui:SymbolIcon ArrowLeft24}"
                               Appearance="Secondary" Margin="0,0,8,0"
                               Command="{Binding BackToGalleryCommand}" />
                    <ui:Button Content="克制分析" Icon="{ui:SymbolIcon ArrowSwap24}"
                               Appearance="Primary"
                               Command="{Binding OpenCounterCommand}" />
                </StackPanel>
            </Grid>

            <!-- ============ 主体：整页纵向滚动 ============ -->
            <ScrollViewer Grid.Row="2" x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnDetailScrollChanged">
                <StackPanel Margin="0,0,14,12">

                    <!-- ===== 英雄 banner（常驻：加载中显示等高占位，换英雄时卡片不塌陷） ===== -->
                    <Border x:Name="HeroBanner"
                            Style="{StaticResource DiPanelCardStyle}"
                            Padding="16">
                        <Grid>
                            <!-- 加载占位：高度与真实内容（右侧 180 头图 + 卡片内边距）对齐，
                                 实测两者均为 214px，换英雄时不跳动 -->
                            <Grid Grid.ColumnSpan="2" Height="180"
                                  Visibility="{Binding ShowHeroPlaceholder, Converter={StaticResource BoolVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:ProgressRing Width="30" Height="30" IsIndeterminate="True"
                                                     HorizontalAlignment="Center" />
                                    <TextBlock Text="正在加载英雄资料…" Margin="0,14,0,0"
                                               FontSize="13" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 真实内容：仅在基础信息就绪后显示（否则会露出一堆空框架） -->
                            <Grid Visibility="{Binding HasHero, Converter={StaticResource BoolVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                            <!-- 身份信息 -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0"
                                        VerticalAlignment="Center">
                                <!-- 主属性 / 攻击方式 / 复杂度 -->
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="3" Height="14" VerticalAlignment="Center"
                                               Fill="{Binding Hero.PrimaryAttr, Converter={StaticResource AttrBrush}}" />
                                    <Image Source="{Binding Hero.PrimaryAttrIcon}"
                                           Width="20" Height="20" Margin="8,0,0,0"
                                           Stretch="Uniform" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Hero.PrimaryAttr}" Margin="6,0,0,0"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />

                                    <Rectangle Width="1" Height="12" Margin="12,0"
                                               Fill="{DynamicResource DiStrokeBrush}" VerticalAlignment="Center" />

                                    <Path Data="{StaticResource DiMeleeSword}" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{DynamicResource DiMutedTextBrush}"
                                          Visibility="{Binding Hero.IsMelee, Converter={StaticResource BoolVisibility}}" />
                                    <ui:SymbolIcon Symbol="TargetArrow24" FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DiMutedTextBrush}"
                                                   Visibility="{Binding Hero.IsRanged, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding Hero.AttackTypeText}" Margin="6,0,0,0"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />

                                    <Rectangle Width="1" Height="12" Margin="12,0"
                                               Fill="{DynamicResource DiStrokeBrush}" VerticalAlignment="Center" />

                                    <TextBlock Text="复杂度" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="◆" FontSize="14" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource DiAccentBrush}"
                                                   Visibility="{Binding HasComplexity1, Converter={StaticResource BoolVisibility}}" />
                                        <TextBlock Text="◆" FontSize="14" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource DiAccentBrush}"
                                                   Visibility="{Binding HasComplexity2, Converter={StaticResource BoolVisibility}}" />
                                        <TextBlock Text="◆" FontSize="14"
                                                   Foreground="{DynamicResource DiAccentBrush}"
                                                   Visibility="{Binding HasComplexity3, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 英雄头像 + 名字 -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Width="52" Height="52"
                                            CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource DiStrokeBrush}"
                                            Background="{DynamicResource DiChromeBrush}"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding Hero.SmallIconUrl, Converter={StaticResource CachedImage}, ConverterParameter=64}"
                                               Stretch="Uniform" Margin="2"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hero.DisplayName}"
                                                   FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Hero.EnglishName}"
                                                   Margin="0,2,0,0" FontSize="12"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 一句话定位 -->
                                <TextBlock Text="{Binding Profile.NpeDesc}"
                                           Margin="0,12,0,0" FontSize="14"
                                           TextWrapping="Wrap" LineHeight="23"
                                           MaxWidth="620" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource DiMutedTextBrush}" />

                                <!-- 定位标签 -->
                                <ItemsControl ItemsSource="{Binding Hero.ChineseRoles}"
                                              Margin="0,14,0,0"
                                              Visibility="{Binding Hero.HasRoles, Converter={StaticResource BoolVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource DiChromeBrush}"
                                                    CornerRadius="4" Padding="8,2" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 对位克制速览：与克制页签同源数据，就绪后显示 -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                            Visibility="{Binding HasMatchupTop, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="天敌" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource DiDisadvantageBrush}" />
                                    <ItemsControl ItemsSource="{Binding MatchupTopCountered}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="48" Height="48" CornerRadius="4" ClipToBounds="True"
                                                        BorderThickness="1" BorderBrush="{DynamicResource DiDisadvantageBrush}"
                                                        Background="{DynamicResource DiChromeBrush}" Margin="0,0,6,0"
                                                        ToolTip="{Binding HeroName, StringFormat=克制我方 {0} {WinRateDiffText}}">
                                                    <!-- 英雄名旁的小头像同款（icons/ 59×33）：方框内完整显示，不裁切不压缩 -->
                                                    <Image Source="{Binding SmallIconUrl, Converter={StaticResource CachedImage}, ConverterParameter=96}"
                                                           Stretch="Uniform" Margin="3" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="天克" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" Margin="18,0,8,0"
                                               Foreground="{DynamicResource DiAdvantageBrush}" />
                                    <ItemsControl ItemsSource="{Binding MatchupTopCounters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="48" Height="48" CornerRadius="4" ClipToBounds="True"
                                                        BorderThickness="1" BorderBrush="{DynamicResource DiDisadvantageBrush}"
                                                        Background="{DynamicResource DiChromeBrush}" Margin="0,0,6,0"
                                                        ToolTip="{Binding HeroName, StringFormat=我方克制 {0} {WinRateDiffText}}">
                                                    <!-- 英雄名旁的小头像同款（icons/ 59×33）：方框内完整显示，不裁切不压缩 -->
                                                    <Image Source="{Binding SmallIconUrl, Converter={StaticResource CachedImage}, ConverterParameter=96}"
                                                           Stretch="Uniform" Margin="3" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="完整分析见「克制」页签" FontSize="11"
                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 头图：1:1 正方形，匹配官方渲染素材（webm 与 poster 同为 1440×1440）。
                                 封面与动图共用这一块区域：视频就绪后封面淡出交叉过渡。
                                 深色媒体窗：透明渲染图专为深底设计，浅底会让边缘发灰显糊。 -->
                            <Border Grid.Column="1" Width="180" Height="180"
                                    CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource DiHeroMediaBrush}"
                                    BorderBrush="{DynamicResource DiStrokeBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    SizeChanged="OnPosterFrameSizeChanged">
                                <Grid>
                                    <Grid.Clip>
                                        <!-- Rect 由 OnPosterFrameSizeChanged 跟随实际尺寸更新 -->
                                        <RectangleGeometry x:Name="PosterClip" Rect="0,0,180,180"
                                                           RadiusX="4" RadiusY="4" />
                                    </Grid.Clip>
                                    <wv2:WebView2CompositionControl x:Name="HeroVideoView"
                                                                    DefaultBackgroundColor="Transparent"
                                                                    IsHitTestVisible="False" />
                                    <Image x:Name="HeroPosterImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.CachingHint="Cache" />
                                    <!-- 详情资料（含头图）未到位时的等待指示 -->
                                    <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
                                </Grid>
                            </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,14,0,0">

                        <!-- ===================== 总览 ===================== -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="460" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            <!-- 属性：官网式单面板 -->
                            <Border Grid.Row="0" Style="{StaticResource DiPanelCardStyle}" Padding="16"
                                    Visibility="{Binding HasHero, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Style="{StaticResource DiCardTitleRow}">
                                        <TextBlock Text="属性" Style="{StaticResource DiSectionTitleStyle}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" CornerRadius="4" Padding="14,12"
                                            Background="{DynamicResource DiRowBrush}"
                                            BorderBrush="{DynamicResource DiStrokeBrush}"
                                            BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 左：头像 + 生命/魔法条 -->
                                                <StackPanel Width="150">
                                                    <Border Height="84" CornerRadius="4,4,0,0" ClipToBounds="True"
                                                            Background="{DynamicResource DiChromeBrush}">
                                                        <Image Source="{Binding Hero.IconUrl, Converter={StaticResource CachedImage}, ConverterParameter=320}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <!-- 生命 -->
                                                    <Border Height="22">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#3F8B2B" Offset="0" />
                                                                <GradientStop Color="#6CD837" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Hero.TotalHealth}"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="White" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Hero.TotalHealthRegen, StringFormat=+{0:F1}}"
                                                                       FontSize="10" Margin="0,0,7,0"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="#D6F7C8" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- 魔法 -->
                                                    <Border Height="22" Margin="0,2,0,0" CornerRadius="0,0,4,4">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#1F6FE0" Offset="0" />
                                                                <GradientStop Color="#5FCEF7" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Hero.TotalMana}"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="White" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Hero.TotalManaRegen, StringFormat=+{0:F1}}"
                                                                       FontSize="10" Margin="0,0,7,0"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="#D4F0FF" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 右：三维属性。三行共享列（图标/基础值/成长），保证不同位数下依然纵向对齐 -->
                                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="44" />
                                                        <RowDefinition Height="44" />
                                                        <RowDefinition Height="44" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Row="0" Source="{Binding Source={x:Static helpers:HeroAssetHelper.StrIcon}}"
                                                           Width="30" Height="30" Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hero.BaseStr}"
                                                               Margin="12,0,0,0" FontSize="20" FontWeight="Medium"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Hero.StrGain, StringFormat=+{0:F1}}"
                                                               Margin="10,6,0,0" FontSize="13"
                                                               Foreground="{DynamicResource DiMutedTextBrush}"
                                                               VerticalAlignment="Center" />

                                                    <Image Grid.Row="1" Source="{Binding Source={x:Static helpers:HeroAssetHelper.AgiIcon}}"
                                                           Width="30" Height="30" Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hero.BaseAgi}"
                                                               Margin="12,0,0,0" FontSize="20" FontWeight="Medium"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Hero.AgiGain, StringFormat=+{0:F1}}"
                                                               Margin="10,6,0,0" FontSize="13"
                                                               Foreground="{DynamicResource DiMutedTextBrush}"
                                                               VerticalAlignment="Center" />

                                                    <Image Grid.Row="2" Source="{Binding Source={x:Static helpers:HeroAssetHelper.IntIcon}}"
                                                           Width="30" Height="30" Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hero.BaseInt}"
                                                               Margin="12,0,0,0" FontSize="20" FontWeight="Medium"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Hero.IntGain, StringFormat=+{0:F1}}"
                                                               Margin="10,6,0,0" FontSize="13"
                                                               Foreground="{DynamicResource DiMutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- 右：天梯数据 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="20,0,0,0">
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="公开胜率" FontSize="11"
                                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                                        <TextBlock Text="{Binding Hero.WinRateText}"
                                                                   Margin="0,4,0,0" FontSize="20" FontWeight="Medium"
                                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="选取率" FontSize="11"
                                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                                        <TextBlock Text="{Binding Hero.PickRateText}"
                                                                   Margin="0,4,0,0" FontSize="20" FontWeight="Medium"
                                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="对局样本" FontSize="11"
                                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                                        <TextBlock Text="{Binding Hero.Matches, StringFormat={}{0:N0}}"
                                                                   Margin="0,4,0,0" FontSize="20" FontWeight="Medium"
                                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Margin="0,12"
                                                    Background="{DynamicResource DiStrokeBrush}" />

                                            <!-- 攻击 / 防御 / 机动性 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel HorizontalAlignment="Left">
                                                    <TextBlock Text="攻击" FontSize="12" Margin="0,0,0,8"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="攻击力">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.DamageIcon}" ToolTip="攻击力" />
                                                        <TextBlock Text="{Binding Hero.BaseDamageText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="攻击间隔">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.AttackTimeIcon}" ToolTip="攻击间隔" />
                                                        <TextBlock Text="{Binding Hero.AttackRateText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="攻击距离">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.AttackRangeIcon}" ToolTip="攻击距离" />
                                                        <TextBlock Text="{Binding Hero.AttackRange}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" ToolTip="弹道速度">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.ProjectileSpeedIcon}" ToolTip="弹道速度" />
                                                        <TextBlock Text="{Binding Hero.ProjectileSpeedText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                    <TextBlock Text="防御" FontSize="12" Margin="0,0,0,8"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="护甲">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.ArmorIcon}" ToolTip="护甲" />
                                                        <TextBlock Text="{Binding Hero.TotalArmorText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" ToolTip="魔法抗性">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.MagicResistIcon}" ToolTip="魔法抗性" />
                                                        <TextBlock Text="{Binding Hero.MagicResistText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                                    <TextBlock Text="机动性" FontSize="12" Margin="0,0,0,8"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="移动速度">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.MoveSpeedIcon}" ToolTip="移动速度" />
                                                        <TextBlock Text="{Binding Hero.MoveSpeed}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="转身速率">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.TurnRateIcon}" ToolTip="转身速率" />
                                                        <TextBlock Text="{Binding TurnRateText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" ToolTip="视野（昼 / 夜）">
                                                    <Image Style="{StaticResource DiGlyphIcon}" Source="{x:Static helpers:HeroAssetHelper.VisionIcon}" ToolTip="视野（昼 / 夜）" />
                                                        <TextBlock Text="{Binding Hero.VisionText}" Margin="8,0,0,0"
                                                                   Style="{StaticResource DiMiniValue}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </Border>

                            <!-- 定位：置于属性卡下方 -->
                            <Border Grid.Row="1" Style="{StaticResource DiPanelCardStyle}" Padding="16" Margin="0,14,0,0"
                                    Visibility="{Binding Hero.HasRoles, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource DiCardTitleRow}">
                                            <TextBlock Text="定位" Style="{StaticResource DiSectionTitleStyle}" />
</StackPanel>
                                        <ItemsControl ItemsSource="{Binding Hero.RoleStats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                                        <ProgressBar Margin="0,5,0,0" Height="4"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding Score}"
                                                                     Style="{StaticResource DiThinProgressStyle}"
                                                                     Foreground="{DynamicResource DiSecondaryTextBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 右栏：背景故事（独占整列，短文本垂直居中避免卡内空白） -->
                            <Border Grid.Column="2" Style="{StaticResource DiPanelCardStyle}" Padding="16"
                                    Visibility="{Binding HasBio, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Style="{StaticResource DiCardTitleRow}">
                                        <TextBlock Text="背景故事" Style="{StaticResource DiSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Profile.Bio}"
                                               FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </Grid>
                            </Border>

                            <!-- 无资料兜底 -->
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="暂无该英雄的详细资料"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,40,0,0" FontSize="13"
                                       Foreground="{DynamicResource DiMutedTextBrush}"
                                       Visibility="{Binding ShowProfileMissing, Converter={StaticResource BoolVisibility}}" />
                        </Grid>

                        <!-- ===================== 技能与成长（页签卡：技能 / 先天 / 天赋） ===================== -->
                        <Border Style="{StaticResource DiPanelCardStyle}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Border Padding="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource DiChromeBrush}" CornerRadius="6"
                                        Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="技能" Style="{StaticResource DiSegmentedItem}"
                                                     IsChecked="{Binding SkillTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=0, Mode=TwoWay}" />
                                        <RadioButton Content="先天技能" Style="{StaticResource DiSegmentedItem}"
                                                     IsChecked="{Binding SkillTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=1, Mode=TwoWay}" />
                                        <RadioButton Content="天赋树" Style="{StaticResource DiSegmentedItem}"
                                                     IsChecked="{Binding SkillTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=2, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <!-- 页签 0：技能 -->
                                <StackPanel Visibility="{Binding SkillTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=0}">
                                    <TextBlock Text="点击图标查看详情" FontSize="11" Margin="0,0,0,10"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding NormalAbilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DiAbilityTile}"
                                                        ToolTip="{Binding DisplayName}"
                                                        Command="{Binding DataContext.SelectAbilityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 选中技能详情：页签内的子面板 -->
                                    <Border Background="{DynamicResource DiRowBrush}"
                                            BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="12" Margin="0,14,0,0"
                                            Visibility="{Binding SelectedAbility, Converter={StaticResource NullVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="4"
                                                Background="{DynamicResource DiChromeBrush}"
                                                BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding SelectedAbility.IconUrl, Converter={StaticResource CachedImage}, ConverterParameter=128}"
                                                   Margin="5" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedAbility.DisplayName}"
                                                       FontSize="15" FontWeight="Medium"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,7,0,0">
                                                <Border Background="{DynamicResource DiRowBrush}" CornerRadius="3" Padding="7,2"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding SelectedAbility.IsPassive, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="被动" FontSize="11"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource DiGoldSoftBrush}" CornerRadius="3" Padding="7,2"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding SelectedAbility.HasScepter, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="神杖升级" FontSize="11"
                                                               Foreground="{DynamicResource DiGoldBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource DiGoldSoftBrush}" CornerRadius="3" Padding="7,2"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding SelectedAbility.GrantedByScepter, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="神杖提供" FontSize="11"
                                                               Foreground="{DynamicResource DiGoldBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource DiShardSoftBrush}" CornerRadius="3" Padding="7,2"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding SelectedAbility.HasShard, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="魔晶升级" FontSize="11"
                                                               Foreground="{DynamicResource DiShardBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource DiShardSoftBrush}" CornerRadius="3" Padding="7,2"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding SelectedAbility.GrantedByShard, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="魔晶提供" FontSize="11"
                                                               Foreground="{DynamicResource DiShardBrush}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 冷却 / 耗蓝 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                                                    Visibility="{Binding SelectedAbility.HasCooldown, Converter={StaticResource BoolVisibility}}">
                                            <Rectangle Width="15" Height="15" VerticalAlignment="Center"
                                                       Fill="{DynamicResource DiMutedTextBrush}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{x:Static helpers:HeroAssetHelper.AttackTimeIcon}" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <TextBlock Margin="7,0,0,0" Style="{StaticResource DiMiniValue}"
                                                       Text="{Binding SelectedAbility.CooldownText, StringFormat={}{0} 秒}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding SelectedAbility.HasManaCost, Converter={StaticResource BoolVisibility}}">
                                            <Rectangle Width="15" Height="15" VerticalAlignment="Center"
                                                       Fill="{DynamicResource DiMutedTextBrush}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding Source={x:Static helpers:HeroAssetHelper.ManaIcon}}" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <TextBlock Margin="7,0,0,0" Style="{StaticResource DiMiniValue}"
                                                       Text="{Binding SelectedAbility.ManaCostText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedAbility.Description}"
                                               Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                                               LineHeight="22"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />

                                    <ItemsControl ItemsSource="{Binding SelectedAbility.Notes}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                                           LineHeight="20" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource DiMutedTextBrush}">
                                                    <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding SelectedAbility.Lore}"
                                               Margin="0,10,0,0" FontSize="12"
                                               TextWrapping="Wrap" LineHeight="20"
                                               Foreground="{DynamicResource DiMutedTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAbility.Lore}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 神杖升级说明 -->
                                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="4"
                                            Background="{DynamicResource DiRowBrush}"
                                            Visibility="{Binding SelectedAbility.HasScepterDescription, Converter={StaticResource BoolVisibility}}">
                                        <DockPanel>
                                            <Rectangle DockPanel.Dock="Left" Width="3" Margin="0,0,10,0"
                                                       Fill="{DynamicResource DiGoldBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="阿哈利姆神杖" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource DiGoldBrush}" />
                                                <TextBlock Text="{Binding SelectedAbility.ScepterDescription}"
                                                           Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                           LineHeight="20"
                                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- 魔晶升级说明 -->
                                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="4"
                                            Background="{DynamicResource DiRowBrush}"
                                            Visibility="{Binding SelectedAbility.HasShardDescription, Converter={StaticResource BoolVisibility}}">
                                        <DockPanel>
                                            <Rectangle DockPanel.Dock="Left" Width="3" Margin="0,0,10,0"
                                                       Fill="{DynamicResource DiShardBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="阿哈利姆魔晶" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource DiShardBrush}" />
                                                <TextBlock Text="{Binding SelectedAbility.ShardDescription}"
                                                           Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                           LineHeight="20"
                                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="暂无技能数据" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,24,0,0"
                                       Foreground="{DynamicResource DiMutedTextBrush}"
                                       Visibility="{Binding SelectedAbility, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}" />
                                </StackPanel>

                                <!-- 页签 1：先天技能 -->
                                <StackPanel Visibility="{Binding SkillTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=1}">
                                    <ItemsControl ItemsSource="{Binding InnateAbilities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="12" CornerRadius="4"
                                                        Background="{DynamicResource DiRowBrush}"
                                                        BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="42" Height="42" CornerRadius="4"
                                                                Background="{DynamicResource DiChromeBrush}"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding IconUrl, Converter={StaticResource CachedImage}, ConverterParameter=128}"
                                                                   Margin="4" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="14" FontWeight="Medium"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                                <Border Background="{DynamicResource DiChromeBrush}" CornerRadius="3" Padding="7,2"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding IsPassive, Converter={StaticResource BoolVisibility}}">
                                                                    <TextBlock Text="被动" FontSize="11"
                                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Margin="0,6,0,0" FontSize="12"
                                                                       TextWrapping="Wrap" LineHeight="20"
                                                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                                                                   LineHeight="20" Margin="0,2,0,0"
                                                                                   Foreground="{DynamicResource DiMutedTextBrush}">
                                                                            <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 页签 2：天赋树 -->
                                <StackPanel Visibility="{Binding SkillTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=2}">

                                <Border Padding="20,8" CornerRadius="4"
                                        Background="{DynamicResource DiRowBrush}"
                                        BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                        Visibility="{Binding HasTalents, Converter={StaticResource BoolVisibility}}">
                                    <Grid>
                                        <Rectangle Width="2" HorizontalAlignment="Center"
                                                   Fill="{DynamicResource DiStrokeBrush}" Margin="0,18" />
                                        <ItemsControl ItemsSource="{Binding TalentRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="70">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Left}"
                                                                   TextAlignment="Right" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                                   FontSize="13" LineHeight="19"
                                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                        <Border Grid.Column="1" Width="36" Height="36"
                                                                CornerRadius="18" BorderThickness="1"
                                                                BorderBrush="{DynamicResource DiMutedTextBrush}"
                                                                Background="{DynamicResource DiPanelBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Level}"
                                                                       FontSize="13" FontWeight="Medium"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Right}"
                                                                   TextAlignment="Left" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                                                   FontSize="13" LineHeight="19"
                                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <TextBlock Text="暂无天赋数据" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,24,0,0"
                                           Foreground="{DynamicResource DiMutedTextBrush}"
                                           Visibility="{Binding HasTalents, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                                <TextBlock Text="每个等级可在两个天赋中选择一个，25 级为最高级天赋"
                                           Margin="2,12,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===================== 对位与分段（页签卡：对位克制 / 天梯分段） ===================== -->
                        <Border Style="{StaticResource DiPanelCardStyle}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Border Padding="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource DiChromeBrush}" CornerRadius="6"
                                        Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="对位克制" Style="{StaticResource DiSegmentedItem}"
                                                     IsChecked="{Binding MatchupTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=0, Mode=TwoWay}" />
                                        <RadioButton Content="天梯分段" Style="{StaticResource DiSegmentedItem}"
                                                     IsChecked="{Binding MatchupTabIndex, Converter={StaticResource IntEquality}, ConverterParameter=1, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <!-- 页签 0：对位克制 -->
                                <StackPanel Visibility="{Binding MatchupTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=0}">

                            <!-- 状态 + 刷新 -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="对位克制" Style="{StaticResource DiSectionTitleStyle}" />
                                    <TextBlock Text="{Binding MatchupStatus}" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="10,0,0,0"
                                                     Visibility="{Binding IsLoadingMatchups, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding PickOptions}"
                                              SelectedItem="{Binding PickedHero, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Width="170"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="切换要分析克制关系的英雄" />
                                    <ui:Button Content="刷新分析" Icon="{ui:SymbolIcon ArrowSync24}"
                                               Appearance="Secondary" Padding="12,4"
                                               VerticalAlignment="Center"
                                               Command="{Binding RefreshMatchupsCommand}"
                                               ToolTip="重新拉取该英雄的对位数据" />
                                </StackPanel>
                            </Grid>

                            <!-- 完整双栏克制列表（最多 40 条，内部滚动） -->
                            <Grid Visibility="{Binding HasMatchupPreview, Converter={StaticResource BoolVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource DiRowBrush}"
                                        BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                        CornerRadius="4" ClipToBounds="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CounteredByList.Count}"
                                                           FontSize="18" FontWeight="Medium"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiDisadvantageBrush}" />
                                                <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           Fill="{DynamicResource DiDisadvantageBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="不利对位" Style="{StaticResource DiSectionTitleStyle}" />
                                                    <TextBlock Text="对方克制你" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding CounteredByList}"
                                                          ItemTemplate="{StaticResource MatchupRow}"
                                                          Margin="12,8" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource DiRowBrush}"
                                        BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                        CornerRadius="4" ClipToBounds="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountersList.Count}"
                                                           FontSize="18" FontWeight="Medium"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DiAdvantageBrush}" />
                                                <Rectangle Width="3" Height="18" Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           Fill="{DynamicResource DiAdvantageBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="有利对位" Style="{StaticResource DiSectionTitleStyle}" />
                                                    <TextBlock Text="你克制对方" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding CountersList}"
                                                          ItemTemplate="{StaticResource MatchupRow}"
                                                          Margin="12,8" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- 对位优势分布 -->
                            <Border Background="{DynamicResource DiRowBrush}"
                                    BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="14,10" Margin="0,12,0,0"
                                    Visibility="{Binding MatchupHasData, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="200" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="对位优势分布" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" Margin="2,0,2,4" />
                                    <lvc:CartesianChart Grid.Row="1"
                                                        Background="Transparent"
                                                        Series="{Binding MatchupSeries}"
                                                        XAxes="{Binding MatchupXAxes}"
                                                        YAxes="{Binding MatchupYAxes}"
                                                        LegendPosition="Hidden"
                                                        DataPointerDown="OnMatchupChartPointerDown"
                                                        ToolTip="点击柱子查看该英雄的克制分析" />
                                </Grid>
                            </Border>

                            <!-- 空态 -->
                            <Border Background="{DynamicResource DiRowBrush}"
                                    BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="32"
                                    Visibility="{Binding HasMatchupPreview, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                                <StackPanel>
                                    <TextBlock Text="对位数据尚未就绪"
                                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="可能仍在加载，或该英雄暂无足够的对局样本。"
                                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="点击任意一行可直达该英雄的克制分析"
                                       Margin="2,12,0,0" FontSize="11"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>

                                <!-- 页签 1：天梯分段 -->
                                <StackPanel Visibility="{Binding MatchupTabIndex, Converter={StaticResource IntEqualsVisibility}, ConverterParameter=1}">

                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="天梯分段胜率" Style="{StaticResource DiSectionTitleStyle}" />
                                    <TextBlock Text="同一英雄在八个分段里的选取与胜率差异" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Hero.Matches, StringFormat=全分段 {0:N0} 场}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource DiMutedTextBrush}" />
                            </Grid>

                            <Border Background="{DynamicResource DiRowBrush}"
                                    BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="18,14"
                                    Visibility="{Binding HasBrackets, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="分段" FontSize="11"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="选取场次" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="胜率（40–60% 区间展开，中线 50%）"
                                                   Margin="14,0" FontSize="11"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="胜率" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource DiStrokeBrush}" />

                                    <ItemsControl ItemsSource="{Binding Hero.Brackets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" MinWidth="180" />
                                                        <ColumnDefinition Width="68" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PicksText}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />

                                                    <Grid Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
                                                        <ProgressBar Style="{StaticResource DiThinProgressStyle}"
                                                                     Height="8"
                                                                     Value="{Binding WinRate, Mode=OneWay, Converter={StaticResource BracketWinRateProgress}}"
                                                                     Foreground="{Binding WinRate, Converter={StaticResource BracketWinRateBrush}}" />
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource DiStrokeBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   IsHitTestVisible="False" />
                                                    </Grid>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding WinRateText}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{Binding WinRate, Converter={StaticResource BracketWinRateBrush}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource DiRowBrush}"
                                    BorderBrush="{DynamicResource DiStrokeBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="32"
                                    Visibility="{Binding HasBrackets, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                                <StackPanel>
                                    <TextBlock Text="暂无分段数据"
                                               Style="{StaticResource DiSectionTitleStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="该英雄在天梯各分段的对局样本不足，或数据仍在加载。"
                                               Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="数据来源：OpenDota 天梯分段统计，段位由低到高排列；胜率条以 50% 为中线，绿色表示高于 50%"
                                       Margin="2,12,0,0" FontSize="11"
                                       Foreground="{DynamicResource DiMutedTextBrush}" />
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
