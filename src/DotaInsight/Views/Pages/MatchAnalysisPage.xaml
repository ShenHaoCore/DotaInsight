<Page x:Class="DotaInsight.Views.Pages.MatchAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      Title="战绩分析"
      Background="Transparent">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 我的账号：查询过的账号做成卡片，点头像即切换 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="12" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- 查询栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource DiPanelBrush}"
                BorderBrush="{DynamicResource DiStrokeBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Rectangle Width="7" Height="7" Fill="{DynamicResource DiAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="MATCH RECORDS" Style="{StaticResource DiKickerTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="战绩分析" Style="{StaticResource DiPageTitleStyle}" />
                </StackPanel>

                <ui:TextBox Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            PlaceholderText="Account ID 或 SteamID64"
                            Text="{Binding AccountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Grid.Column="2"
                           Content="查询"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}"
                           Command="{Binding SearchCommand}"
                           Margin="10,0,0,0"
                           Padding="16,8"
                           VerticalAlignment="Center" />

                <ui:ProgressRing Grid.Column="3"
                                 Width="26"
                                 Height="26"
                                 Margin="10,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- 我的账号：查询过的账号自动缓存成卡片，点头像即切换并查询 -->
        <Border Grid.Row="1"
                Background="{DynamicResource DiPanelBrush}"
                BorderBrush="{DynamicResource DiStrokeBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,12"
                Margin="0,0,0,12"
                Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right"
                               Text="点击卡片切换账号，右上角 × 移除"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="7" Height="7" Fill="{DynamicResource DiAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="我的账号" Style="{StaticResource DiKickerTextStyle}" />
                        <TextBlock Text="{Binding Accounts.Count, StringFormat={}· {0}}"
                                   Style="{StaticResource DiKickerTextStyle}" Margin="4,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,6">
                                <Button Style="{StaticResource DiAccountCardStyle}"
                                        Command="{Binding DataContext.SwitchAccountCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding ToolTipText}">
                                    <Grid Width="184">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 头像：圆形；没拿到资料时显示人形占位 -->
                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                ClipToBounds="True"
                                                Background="{DynamicResource DiChromeBrush}"
                                                BorderBrush="{DynamicResource DiStrokeBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="PersonCircle24"
                                                               FontSize="22"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=96}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DiGoldBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProfile}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="·" FontSize="11" Margin="5,0"
                                                           Foreground="{DynamicResource DiMutedTextBrush}" />
                                                <TextBlock Text="{Binding LastUsedText}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource DiMutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Width="18" Height="18"
                                        Style="{StaticResource DiAccountRemoveButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-6,-6,0"
                                        ToolTip="移除该账号"
                                        Command="{Binding DataContext.RemoveAccountCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 玩家摘要 -->
        <Border Grid.Row="2"
                Background="{DynamicResource DiHeroBannerBrush}"
                BorderBrush="{DynamicResource DiStrokeBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,12"
                Visibility="{Binding Profile, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="68"
                        Height="68"
                        CornerRadius="34"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource DiStrokeBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource DiChromeBrush}"
                        Margin="0,0,16,0">
                    <Image Source="{Binding Profile.AvatarUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=140}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.PersonaName}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DiPrimaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="{DynamicResource DiGoldSoftBrush}"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding Profile.RankText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DiGoldBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Profile.RecordText}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Profile.WinRateText, StringFormat={}总胜率 {0}}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RecentSummary}"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Profile.AccountId, StringFormat={}ID {0}}"
                               FontSize="12"
                               Foreground="{DynamicResource DiMutedTextBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 比赛列表 -->
        <Border Grid.Row="3"
                Style="{StaticResource DiPanelCardStyle}"
                ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                    <DockPanel>
                        <Rectangle Width="3" Height="18" Fill="{DynamicResource DiAccentBrush}"
                                   Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="近期比赛"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Matches.Count, StringFormat={}{0} 场}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding Matches}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,4"
                         Cursor="Hand"
                         SelectionChanged="OnMatchSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="点击查看该场比赛详情" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MatchupRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="56"
                                            Height="32"
                                            CornerRadius="3"
                                            ClipToBounds="True"
                                            Background="{DynamicResource DiChromeBrush}"
                                            Margin="0,0,10,0">
                                        <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=120}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeroName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DiPrimaryTextBrush}" />
                                        <TextBlock Text="{Binding SideText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DiMutedTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ResultText}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiAdvantageBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding KdaText}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DiPrimaryTextBrush}" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding KdaRatioText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DurationText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />

                                    <TextBlock Grid.Column="6"
                                               Text="{Binding StartTimeText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource DiMutedTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 胜负走势图 -->
        <Border Grid.Row="5"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="近期胜负走势"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource DiPrimaryTextBrush}"
                           Margin="2,0,2,4" />
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Hidden"
                                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Row="1"
                           Text="查询账号后展示胜负走势"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}"
                           Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>
        </Border>
    </Grid>
</Page>
