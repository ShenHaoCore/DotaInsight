<Page x:Class="DotaInsight.Views.Pages.HeroGalleryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
      xmlns:converters="clr-namespace:DotaInsight.Converters"
      xmlns:models="clr-namespace:DotaInsight.Models"
      Title="英雄图鉴"
      Background="Transparent"
      Loaded="OnPageLoaded">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:AttrBrushConverter x:Key="AttrBrushConverter" />
        <converters:BoolToAppearanceConverter x:Key="BoolToAppearanceConverter" />

        <!-- 分组数据源：扁平列表按主属性分组（虚拟化面板支持分组头） -->
        <CollectionViewSource x:Key="GroupedHeroes" Source="{Binding FilteredHeroes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PrimaryAttr" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="HeroTileTemplate" DataType="{x:Type models:HeroStat}">
            <Button Style="{StaticResource HeroTileButtonStyle}"
                    Width="116" Height="76"
                    Margin="4"
                    ToolTip="{Binding DisplayName}"
                    Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}, ConverterParameter=160}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border VerticalAlignment="Bottom" Background="{DynamicResource DiNameOverlayBrush}">
                        <TextBlock Text="{Binding DisplayName}"
                                   Margin="6,14,6,5"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 分组头：主属性色条 + 名称与数量 -->
        <DataTemplate x:Key="HeroGroupHeaderTemplate">
            <DockPanel Margin="4,0,4,8">
                <Rectangle DockPanel.Dock="Left"
                           Width="4" Height="15"
                           Fill="{Binding Name, Converter={StaticResource AttrBrushConverter}}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource DiSectionTitleStyle}" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}  ·  {1}">
                            <Binding Path="Name" Mode="OneWay" />
                            <Binding Path="ItemCount" Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="英雄图鉴" Style="{StaticResource DiPageTitleStyle}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="12,0,0,0" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <ui:Button Content="全部" Margin="0,0,6,0" Padding="12,4"
                           Command="{Binding SetAttrFilterCommand}" CommandParameter=""
                           Appearance="{Binding IsFilterAll, Converter={StaticResource BoolToAppearanceConverter}}" />
                <ui:Button Content="力量" Margin="0,0,6,0" Padding="12,4"
                           Command="{Binding SetAttrFilterCommand}" CommandParameter="力量"
                           Appearance="{Binding IsFilterStr, Converter={StaticResource BoolToAppearanceConverter}}" />
                <ui:Button Content="敏捷" Margin="0,0,6,0" Padding="12,4"
                           Command="{Binding SetAttrFilterCommand}" CommandParameter="敏捷"
                           Appearance="{Binding IsFilterAgi, Converter={StaticResource BoolToAppearanceConverter}}" />
                <ui:Button Content="智力" Margin="0,0,6,0" Padding="12,4"
                           Command="{Binding SetAttrFilterCommand}" CommandParameter="智力"
                           Appearance="{Binding IsFilterInt, Converter={StaticResource BoolToAppearanceConverter}}" />
                <ui:Button Content="全才" Padding="12,4"
                           Command="{Binding SetAttrFilterCommand}" CommandParameter="全才"
                           Appearance="{Binding IsFilterUni, Converter={StaticResource BoolToAppearanceConverter}}" />
            </StackPanel>

            <ui:AutoSuggestBox Grid.Column="3"
                               VerticalAlignment="Center"
                               PlaceholderText="搜索英雄"
                               OriginalItemsSource="{Binding AllHeroes}"
                               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ClearButtonEnabled="True"
                               SuggestionChosen="OnSuggestionChosen">
                <ui:AutoSuggestBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:AutoSuggestBox.Icon>
            </ui:AutoSuggestBox>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ui:Button Appearance="Transparent"
                           ToolTip="刷新"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 英雄列表：VirtualizingWrapPanel + 分组虚拟化（IsVirtualizingWhenGrouping） -->
        <Border Grid.Row="2"
                Style="{StaticResource DiPanelCardStyle}"
                Padding="16,14">
            <Grid>
                <ListView ItemsSource="{Binding Source={StaticResource GroupedHeroes}}"
                          ItemTemplate="{StaticResource HeroTileTemplate}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.CacheLength="1,1"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel SpacingMode="None" StretchItems="False" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <StaticResource ResourceKey="HeroGroupHeaderTemplate" />
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel>
                                                    <ContentPresenter
                                                        Content="{TemplateBinding ContentControl.Content}"
                                                        ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                        ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                                                        Name="PART_Header" />
                                                    <ItemsPresenter Name="ItemsPresenter" Margin="0" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="没有匹配的英雄"
                               Style="{StaticResource DiSectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="调整搜索词或属性筛选后再试"
                               Margin="0,8,0,0" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DiMutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
