<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- ========== GitHub Primer 浅色主题：白卡 + 浅灰画布 + 绿主色/蓝链接/红语义 ==========
         token 对照（Primer v.light）：canvas #f6f8fa / border #d0d7de / fg #1f2328 / muted #59636e,6e7781
         success #1a7f37 / danger #cf222e / primary btn #1f883d / accent blue #0969da / attention #9a6700 -->
    <Color x:Key="DiCanvasColor">#FFF6F8FA</Color>
    <Color x:Key="DiChromeColor">#FFEFF2F5</Color>
    <Color x:Key="DiPanelColor">#FFFFFFFF</Color>
    <Color x:Key="DiPanelElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="DiStrokeColor">#FFD0D7DE</Color>
    <Color x:Key="DiAccentColor">#FF1F883D</Color>
    <Color x:Key="DiAccentSoftColor">#261F883D</Color>
    <Color x:Key="DiGoldColor">#FF9A6700</Color>
    <Color x:Key="DiGoldSoftColor">#269A6700</Color>
    <Color x:Key="DiShardColor">#FF0969DA</Color>
    <Color x:Key="DiShardSoftColor">#260969DA</Color>
    <!-- 英雄头图媒体窗：透明渲染图(webm/png)专为深底设计，浅底上边缘会发灰显糊 -->
    <Color x:Key="DiHeroMediaTopColor">#FF1C2B3C</Color>
    <Color x:Key="DiHeroMediaBottomColor">#FF0A0F16</Color>
    <Color x:Key="DiAdvantageColor">#FF1A7F37</Color>
    <Color x:Key="DiDisadvantageColor">#FFCF222E</Color>
    <Color x:Key="DiPrimaryTextColor">#FF1F2328</Color>
    <Color x:Key="DiSecondaryTextColor">#FF59636E</Color>
    <Color x:Key="DiMutedTextColor">#FF6E7781</Color>
    <Color x:Key="DiTileColor">#FFFFFFFF</Color>
    <Color x:Key="DiTileHoverColor">#FFF3F4F6</Color>
    <Color x:Key="DiTileHoverBorderColor">#FFB1BAC4</Color>
    <Color x:Key="DiRowColor">#FFF6F8FA</Color>
    <Color x:Key="DiRowHoverColor">#FFEFF2F5</Color>
    <Color x:Key="DiProgressTrackColor">#FFE7EBF0</Color>
    <Color x:Key="DiSectionHeaderColor">#FFF6F8FA</Color>

    <SolidColorBrush x:Key="DiCanvasBrush" Color="{StaticResource DiCanvasColor}" />
    <SolidColorBrush x:Key="DiChromeBrush" Color="{StaticResource DiChromeColor}" />
    <SolidColorBrush x:Key="DiPanelBrush" Color="{StaticResource DiPanelColor}" />
    <SolidColorBrush x:Key="DiPanelElevatedBrush" Color="{StaticResource DiPanelElevatedColor}" />
    <SolidColorBrush x:Key="DiStrokeBrush" Color="{StaticResource DiStrokeColor}" />
    <SolidColorBrush x:Key="DiAccentBrush" Color="{StaticResource DiAccentColor}" />
    <SolidColorBrush x:Key="DiAccentSoftBrush" Color="{StaticResource DiAccentSoftColor}" />
    <SolidColorBrush x:Key="DiGoldBrush" Color="{StaticResource DiGoldColor}" />
    <SolidColorBrush x:Key="DiGoldSoftBrush" Color="{StaticResource DiGoldSoftColor}" />
    <SolidColorBrush x:Key="DiShardBrush" Color="{StaticResource DiShardColor}" />
    <SolidColorBrush x:Key="DiShardSoftBrush" Color="{StaticResource DiShardSoftColor}" />
    <LinearGradientBrush x:Key="DiHeroMediaBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource DiHeroMediaTopColor}" />
        <GradientStop Offset="1" Color="{StaticResource DiHeroMediaBottomColor}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DiAdvantageBrush" Color="{StaticResource DiAdvantageColor}" />
    <SolidColorBrush x:Key="DiDisadvantageBrush" Color="{StaticResource DiDisadvantageColor}" />
    <SolidColorBrush x:Key="DiPrimaryTextBrush" Color="{StaticResource DiPrimaryTextColor}" />
    <SolidColorBrush x:Key="DiSecondaryTextBrush" Color="{StaticResource DiSecondaryTextColor}" />
    <SolidColorBrush x:Key="DiMutedTextBrush" Color="{StaticResource DiMutedTextColor}" />
    <SolidColorBrush x:Key="DiTileBrush" Color="{StaticResource DiTileColor}" />
    <SolidColorBrush x:Key="DiTileHoverBrush" Color="{StaticResource DiTileHoverColor}" />
    <SolidColorBrush x:Key="DiTileHoverBorderBrush" Color="{StaticResource DiTileHoverBorderColor}" />
    <SolidColorBrush x:Key="DiRowBrush" Color="{StaticResource DiRowColor}" />
    <SolidColorBrush x:Key="DiRowHoverBrush" Color="{StaticResource DiRowHoverColor}" />
    <SolidColorBrush x:Key="DiProgressTrackBrush" Color="{StaticResource DiProgressTrackColor}" />
    <SolidColorBrush x:Key="DiSectionHeaderBrush" Color="{StaticResource DiSectionHeaderColor}" />

    <!-- 磁贴底部名称条的可读性压暗 -->
    <LinearGradientBrush x:Key="DiNameOverlayBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#D91F2328" Offset="1" />
    </LinearGradientBrush>

    <!-- ========== 圆角 / 间距 token（Primer 组件圆角 6px） ========== -->
    <CornerRadius x:Key="DiCornerSm">4</CornerRadius>
    <CornerRadius x:Key="DiCornerMd">6</CornerRadius>
    <CornerRadius x:Key="DiCornerLg">6</CornerRadius>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace1">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace2">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace3">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace4">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace5">24</sys:Double>
</ResourceDictionary>
