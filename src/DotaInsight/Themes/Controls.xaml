<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:DotaInsight.Converters">

    <!-- ================= 转换器 ================= -->
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:AdvantageToProgressConverter x:Key="AdvantageToProgressConverter" />
    <converters:AdvantageBrushConverter x:Key="AdvantageBrushConverter" />
    <converters:ProgressRatioConverter x:Key="ProgressRatioConverter" />
    <converters:BracketWinRateToProgressConverter x:Key="BracketWinRateProgress" />
    <converters:BracketWinRateBrushConverter x:Key="BracketWinRateBrush" />
    <converters:CachedImageConverter x:Key="CachedImageConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:AttrBrushConverter x:Key="AttrBrushConverter" />
    <converters:BoolToAppearanceConverter x:Key="BoolToAppearanceConverter" />

    <!-- ================= 文字层级 =================
         字阶：11 / 12 / 13 / 15 / 17 / 20 / 24 / 32；字重 400/500，强调 600 -->
    <!-- 小节标签：卡片内的微型列头 -->
    <Style x:Key="DiKickerTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 说明文字：多行内容用 secondary，短提示用 muted -->
    <Style x:Key="DiBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource DiSecondaryTextBrush}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- 页面大标题：唯一用 600 的地方 -->
    <Style x:Key="DiPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 区块标题：字号承担层级，不再加重 -->
    <Style x:Key="DiSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 列表行内的排位序号：安静等宽数字 -->
    <Style x:Key="DiRankNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Width" Value="22" />
    </Style>

    <!-- ============ 分段页签：选中态 = 浮起面板 + 主文字色（中性，不与主按钮抢焦点） ============ -->
    <Style x:Key="DiSegmentedItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DiRowHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DiPanelElevatedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 行 / 区块 / 进度条 ================= -->
    <!-- 数据行：安静的条纹，不描边——列表行再描边就成了堆叠的盒子；
         分层靠底色与 2px 行距，悬停抬表面 -->
    <Style x:Key="MatchupRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DiRowBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DiRowHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 卡片头：标题行 + 底部分隔线（无底色带，全局统一轻量卡头） -->
    <Style x:Key="SectionHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="AdvantageProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{DynamicResource DiProgressTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 极简进度条模板：ScaleX 精确控制填充，100% 必满、0% 无填充。
         两端固定 3px 圆角：4px 细条呈胶囊形、6px 弹窗条为圆角矩形，一套模板够用 -->
    <ControlTemplate x:Key="DiProgressBarTemplate" TargetType="ProgressBar">
        <Border Height="{TemplateBinding Height}"
                Background="{TemplateBinding Background}"
                CornerRadius="3"
                ClipToBounds="True">
            <Border x:Name="PART_Indicator"
                    Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Stretch">
                <Border.RenderTransform>
                    <ScaleTransform>
                        <ScaleTransform.ScaleX>
                            <MultiBinding Converter="{StaticResource ProgressRatioConverter}">
                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                            </MultiBinding>
                        </ScaleTransform.ScaleX>
                    </ScaleTransform>
                </Border.RenderTransform>
            </Border>
        </Border>
    </ControlTemplate>

    <Style x:Key="DiThinProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{DynamicResource DiProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DiAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource DiProgressBarTemplate}" />
    </Style>

    <!-- 弹窗主进度条：比列表内的细条更粗 -->
    <Style x:Key="DiBarProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{DynamicResource DiProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DiAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource DiProgressBarTemplate}" />
    </Style>

    <!-- 筛选小芯片：checked = 抬表面 + 主文字色，不用强调红（红留给页签/当前账号） -->
    <Style x:Key="DiChipRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DiStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,3">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DiPrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 卡片 ================= -->
    <Style x:Key="DiPanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DiPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================= 英雄磁贴 ================= -->
    <!-- 悬停只抬表面与描边，不做缩放 -->
    <Style x:Key="HeroTileButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DiTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DiTileHoverBorderBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 侧栏导航 ================= -->
    <Style x:Key="DiSidebarItemStyle" TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SteamID 历史记录下拉按钮：ToggleButton + Popup 列表 -->
    <Style x:Key="DiHistoryComboBoxStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource DiPanelElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,4,4,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 历史记录下拉 Popup 内的 ListBox -->
    <Style x:Key="DiHistoryListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource DiPanelElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 已保存账号卡片：当前账号 = 签名红（描边 + 淡底） -->
    <Style x:Key="DiAccountCardStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource DiTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsCurrent 由 SavedAccount 提供，卡片整体重建时刷新 -->
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DiAccentBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DiTileHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 账号卡片右上角的移除按钮（默认半透明，悬停转为警示色） -->
    <Style x:Key="DiAccountRemoveButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource DiMutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource DiPanelElevatedBrush}"
                            BorderBrush="{DynamicResource DiStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DiDisadvantageBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DiDisadvantageBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
