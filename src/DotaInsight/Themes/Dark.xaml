<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- ========== ARENA 深色主题：纯黑底 + 电竞赤红 + 克制金 ========== -->
    <Color x:Key="DiCanvasColor">#FF07090C</Color>
    <Color x:Key="DiChromeColor">#FF0C0F14</Color>
    <Color x:Key="DiPanelColor">#FF11151C</Color>
    <Color x:Key="DiPanelElevatedColor">#FF171C25</Color>
    <Color x:Key="DiStrokeColor">#FF232A36</Color>
    <Color x:Key="DiAccentColor">#FFF03D2E</Color>
    <Color x:Key="DiAccentSoftColor">#26F03D2E</Color>
    <Color x:Key="DiGoldColor">#FFE3B341</Color>
    <Color x:Key="DiGoldSoftColor">#26E3B341</Color>
    <Color x:Key="DiAdvantageColor">#FF2FD57F</Color>
    <Color x:Key="DiDisadvantageColor">#FFF0564A</Color>
    <Color x:Key="DiPrimaryTextColor">#FFF4F7FA</Color>
    <Color x:Key="DiMutedTextColor">#FF8A97A6</Color>
    <Color x:Key="DiTileColor">#FF131821</Color>
    <Color x:Key="DiTileHoverColor">#FF1B222E</Color>
    <Color x:Key="DiRowColor">#FF0E131A</Color>
    <Color x:Key="DiRowHoverColor">#FF161E29</Color>
    <Color x:Key="DiProgressTrackColor">#FF222A37</Color>
    <Color x:Key="DiSectionHeaderColor">#FF0D1219</Color>

    <SolidColorBrush x:Key="DiCanvasBrush" Color="{StaticResource DiCanvasColor}" />
    <SolidColorBrush x:Key="DiChromeBrush" Color="{StaticResource DiChromeColor}" />
    <SolidColorBrush x:Key="DiPanelBrush" Color="{StaticResource DiPanelColor}" />
    <SolidColorBrush x:Key="DiPanelElevatedBrush" Color="{StaticResource DiPanelElevatedColor}" />
    <SolidColorBrush x:Key="DiStrokeBrush" Color="{StaticResource DiStrokeColor}" />
    <SolidColorBrush x:Key="DiAccentBrush" Color="{StaticResource DiAccentColor}" />
    <SolidColorBrush x:Key="DiAccentSoftBrush" Color="{StaticResource DiAccentSoftColor}" />
    <SolidColorBrush x:Key="DiGoldBrush" Color="{StaticResource DiGoldColor}" />
    <SolidColorBrush x:Key="DiGoldSoftBrush" Color="{StaticResource DiGoldSoftColor}" />
    <SolidColorBrush x:Key="DiAdvantageBrush" Color="{StaticResource DiAdvantageColor}" />
    <SolidColorBrush x:Key="DiDisadvantageBrush" Color="{StaticResource DiDisadvantageColor}" />
    <SolidColorBrush x:Key="DiPrimaryTextBrush" Color="{StaticResource DiPrimaryTextColor}" />
    <SolidColorBrush x:Key="DiMutedTextBrush" Color="{StaticResource DiMutedTextColor}" />
    <SolidColorBrush x:Key="DiTileBrush" Color="{StaticResource DiTileColor}" />
    <SolidColorBrush x:Key="DiTileHoverBrush" Color="{StaticResource DiTileHoverColor}" />
    <SolidColorBrush x:Key="DiRowBrush" Color="{StaticResource DiRowColor}" />
    <SolidColorBrush x:Key="DiRowHoverBrush" Color="{StaticResource DiRowHoverColor}" />
    <SolidColorBrush x:Key="DiProgressTrackBrush" Color="{StaticResource DiProgressTrackColor}" />
    <SolidColorBrush x:Key="DiSectionHeaderBrush" Color="{StaticResource DiSectionHeaderColor}" />

    <!-- 顶部赤红光晕（静态、只绘制一次） -->
    <RadialGradientBrush x:Key="DiAccentGlowBrush"
                         Center="0.12,0.04" GradientOrigin="0.12,0.04"
                         RadiusX="0.85" RadiusY="0.55"
                         po:Freeze="True">
        <GradientStop Color="#33F03D2E" Offset="0" />
        <GradientStop Color="#0DF03D2E" Offset="0.45" />
        <GradientStop Color="#00F03D2E" Offset="1" />
    </RadialGradientBrush>

    <!-- 极淡战术网格 -->
    <DrawingBrush x:Key="DiGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,32,32" ViewportUnits="Absolute"
                  po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1" Brush="#0DFFFFFF" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="DiHeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A1013" Offset="0" />
        <GradientStop Color="#11151C" Offset="0.5" />
        <GradientStop Color="#0E1A17" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiPickerHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#231015" Offset="0" />
        <GradientStop Color="#11151C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiNameOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#E607090C" Offset="1" />
    </LinearGradientBrush>

    <!-- 国服头图：左重右轻 + 底部融黑 -->
    <LinearGradientBrush x:Key="DiHeroStageScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D9000000" Offset="0" />
        <GradientStop Color="#8C000000" Offset="0.32" />
        <GradientStop Color="#1A000000" Offset="0.62" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DiHeroStageBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#99000000" Offset="0.55" />
        <GradientStop Color="#F2000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DiHeroGlassBrush" Color="#E6171C25" />
    <SolidColorBrush x:Key="DiHeroDashBrush" Color="#FF0A0E13" />

    <!-- ========== 圆角 / 间距 token ========== -->
    <CornerRadius x:Key="DiCornerSm">3</CornerRadius>
    <CornerRadius x:Key="DiCornerMd">4</CornerRadius>
    <CornerRadius x:Key="DiCornerLg">8</CornerRadius>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace1">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace2">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace3">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace4">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DiSpace5">24</sys:Double>
</ResourceDictionary>
