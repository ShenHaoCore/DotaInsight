<ui:FluentWindow x:Class="DotaInsight.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}"
                 Icon="pack://application:,,,/Assets/dota2.ico"
                 Width="1400"
                 Height="900"
                 MinWidth="1100"
                 MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource DiCanvasBrush}">

    <Grid Background="{DynamicResource DiCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="DotaInsight"
                     Background="{DynamicResource DiChromeBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/dota2-48.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock Text="{Binding CurrentPageTitle}"
                           Margin="10,0,0,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DiMutedTextBrush}" />
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button Appearance="Transparent"
                               ToolTip="{Binding ClearCacheTooltip}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ClearCacheCommand}"
                               Margin="0,0,4,0" />
                    <ui:Button Appearance="Transparent"
                               ToolTip="{Binding ThemeToggleTooltip}"
                               Icon="{Binding ThemeToggleIcon}"
                               Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource DiChromeBrush}"
                    BorderBrush="{DynamicResource DiStrokeBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{DynamicResource DiPanelElevatedBrush}"
                            BorderBrush="{DynamicResource DiStrokeBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,22">
                        <Image Source="pack://application:,,,/Assets/dota2-48.png"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource DiSidebarNavButtonStyle}"
                            ToolTip="{Binding ThemeToggleTooltip}"
                            Command="{Binding ToggleThemeCommand}"
                            Margin="0,0,0,16">
                        <ui:SymbolIcon FontSize="18"
                                       Foreground="{DynamicResource DiPrimaryTextBrush}"
                                       Symbol="{Binding ThemeToggleSymbol}" />
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <Button ToolTip="首页"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateHomeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DiSidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNav}" Value="Home">
                                            <Setter Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Home24" FontSize="18"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        </Button>

                        <Button ToolTip="英雄图鉴"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateGalleryCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DiSidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNav}" Value="HeroGallery">
                                            <Setter Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Grid24" FontSize="18"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        </Button>

                        <Button ToolTip="克制分析"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateCounterCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DiSidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNav}" Value="HeroCounter">
                                            <Setter Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        </Button>

                        <Button ToolTip="战绩分析"
                                Command="{Binding NavigateMatchAnalysisCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DiSidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNav}" Value="MatchAnalysis">
                                            <Setter Property="Background" Value="{DynamicResource DiAccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="DataHistogram24" FontSize="18"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource DiPrimaryTextBrush}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame x:Name="PageHost"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"
                   Background="{DynamicResource DiCanvasBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
