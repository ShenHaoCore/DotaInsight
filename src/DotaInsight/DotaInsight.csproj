<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\dota2.ico</ApplicationIcon>
    <RootNamespace>DotaInsight</RootNamespace>
    <AssemblyName>DotaInsight</AssemblyName>
    <!-- 版本号：Releases 通道以 tag 为准（release.yml 用 -p:Version 覆盖），
         这里给本地构建一个基线；应用内升级靠它和远端 tag 比较。 -->
    <Version>0.2.0</Version>
    <AssemblyTitle>DotaInsight</AssemblyTitle>
    <Product>DotaInsight</Product>
    <!-- LiveCharts 传递依赖 OpenTK / SkiaSharp.Views.WPF 的 NU1701 为已知兼容提示 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dota2.ico" />
    <Resource Include="Assets\dota2.png" />
    <Resource Include="Assets\dota2-48.png" />
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Icons\stats\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
